		See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2026-06-02T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20260601/LegalEntities/MetadataBELegalEntities/> ;
    cmns-av:copyright "Copyright (c) 2015-2025 Object Management Group, Inc.",
        "Copyright (c) 2015-2026 EDM Association dba EDM Council, Inc." .

fibo-be-le-mod:LegalEntitiesModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "legal entities module" ;
    dcterms:abstract "The legal entities module contains ontologies that extend the basis for legal personhood and business entities establiched in the OMG's Commons Ontology Library. This includes (1) definitions that distinguish between judicial and natural person, (2) definitions of formally constituted organizations, their members and high-level subdivisions, and identification and classification schemes, (3) definitions of corporate entities and the ways in which they may be incorporated, and (4) definitions required for implementation and use of the ISO 17442 Legal Entity Identifier (LEI) standard." ;
    dcterms:hasPart fibo-be-le-cb:,
        fibo-be-le-fbo:,
        fibo-be-le-lei:,
        fibo-be-le-lp: ;
    dcterms:license """Copyright (c) 2015-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.
		
Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    dcterms:title "FIBO BE Legal Entities Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Legal Entities Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2025 Object Management Group, Inc.",
        "Copyright (c) 2015-2026 EDM Association dba EDM Council, Inc." .

fibo-be-oac-cpty:ControllingAlliance a owl:Class ;
    rdfs:label "controlling alliance" ;
    rdfs:subClassOf fibo-fnd-org-fm:Group ;
    skos:definition "group that has formed some alliance to jointly exercise control over some entity" ;
    skos:editorialNote "The types of entity which may enter into such an alliance are the same types of entity as may exercise control in their own right, i.e. independent parties (that is a logical union of natural persons, legal persons and formal organizations)." .

fibo-be-oac-cpty:CourtAppointedControl a owl:Class ;
    rdfs:label "court appointed control" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-fnd-law-cor:CourtOfLaw ;
            owl:onProperty fibo-fnd-rel-rel:isConferredBy ],
        fibo-fnd-oac-ctl:DeJureControl ;
    skos:definition "control conferred by the actions of some court, for example in the context of receivership" .

fibo-be-oac-cpty:InfluenceBasedDeFactoControl a owl:Class ;
    rdfs:label "influence-based de facto control" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ;
            owl:someValuesFrom fibo-be-oac-cpty:InfluenceBasedDeFactoControllingParty ],
        fibo-fnd-oac-ctl:DeFactoControl ;
    skos:definition "informal control that involves influence over some party" .

fibo-be-oac-cpty:InfluenceBasedDeFactoControllingParty a owl:Class ;
    rdfs:label "influence-based de facto controlling party" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
            owl:someValuesFrom fibo-be-oac-cpty:InfluenceBasedDeFactoControl ],
        fibo-be-oac-cpty:DeFactoControllingInterestParty ;
    skos:definition "party that holds influence-based control over some other party" ;
    skos:editorialNote "Regulatory or jurisdictional control would fall under this control. Court appointed control is de jure control BUT the scenario in which a government takes over something and then hands it over to some new de jure controller i.e. administrator - in the meantime this is de facto control by e.g. the government." .

fibo-be-oac-cpty:InvestmentBasedDeFactoControllingInterestParty a owl:Class ;
    rdfs:label "investment-based de facto controlling interest party" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-be-oac-cpty:InvestmentBasedDeFactoControl ;
            owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ],
        fibo-be-oac-cpty:DeFactoControllingInterestParty,
        fibo-be-oac-opty:Investor ;
    skos:definition "party that holds investment-based control over some other party" .

fibo-be-oac-cpty:SoleControllingParty a owl:Class ;
    rdfs:label "sole controlling party" ;
    rdfs:subClassOf fibo-be-oac-cpty:EntityControllingParty ;
    skos:definition "party that has sole control over and directs the affairs of some legal entity" .

fibo-be-oac-cpty:TotalOwner a owl:Class ;
    rdfs:label "total owner" ;
    rdfs:subClassOf fibo-be-oac-opty:ConstitutionalOwner ;
    skos:definition "party that has 100 percent ownership some legal entity" ;
    skos:editorialNote "By virtue of holding 100 percent of the equity ownership, the Total Owner also holds 100 percent of the controlling equity, if there is a difference. Therefore it is both a total owner and a total controlling party." .

fibo-be-oac-cpty:isAdvisedBy a owl:ObjectProperty ;
    rdfs:label "has advisor" ;
    rdfs:domain fibo-be-oac-cpty:ControlledParty ;
    rdfs:range fibo-fnd-oac-ctl:ControllingParty ;
    rdfs:subPropertyOf fibo-fnd-oac-ctl:hasControllingParty ;
    skos:definition "indicates the party that acts in an advisory capacity to the controlled party" .

fibo-be-oac-cctl:DomesticUltimateParent a owl:Class ;
    rdfs:label "domestic ultimate parent" ;
    rdfs:subClassOf fibo-be-oac-cctl:TotalControllingInterestParty ;
    skos:definition "party that is recognized as the ultimate parent of a given organization within the country or jurisdiction of incorporation or organization" .

fibo-be-oac-cctl:GlobalUltimateParent a owl:Class ;
    rdfs:label "global ultimate parent" ;
    rdfs:subClassOf fibo-be-oac-cctl:TotalControllingInterestParty ;
    skos:definition "party that is recognized as the ultimate parent of a given organization world-wide" .

fibo-be-oac-cctl:VotingShareholder a owl:Class ;
    rdfs:label "voting shareholder" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-oac-exec:BoardMember ;
            owl:onProperty fibo-be-oac-exec:elects ],
        fibo-be-oac-cpty:DeJureControllingInterestParty,
        fibo-be-oac-cown:Shareholder ;
    skos:definition "shareholder whose shares confer the right to vote in corporate elections, including the right to elect directors at annual or special meetings, and to express their views to corporate management and directors on significant issues that may affect the value of those shares" ;
    cmns-av:explanatoryNote "A voting shareholder may exercise control over board composition by (1) attending a shareholder meeting and voting directly, (2) assigning a proxy to vote on their behalf, either as specified in the recommendations made in the proxy card or as indicated in a manner that deviates from those recommendations but is detailed on the proxy card, (3) by rejection of the proxy, either implicitly or explicitly, or (4) through a direct ballot that they create themselves." .

fibo-be-oac-cctl:isControllingAffiliateOf a owl:ObjectProperty ;
    rdfs:label "is controlling affiliate of" ;
    rdfs:domain fibo-be-oac-cctl:ControllingAffiliate ;
    rdfs:range fibo-be-oac-cctl:ControlledAffiliate ;
    rdfs:subPropertyOf fibo-be-oac-cctl:isAffiliateOf,
        cmns-pts:actsOn ;
    owl:inverseOf fibo-be-oac-cctl:hasControllingAffiliate ;
    skos:definition "controls directly, or indirectly through one or more intermediaries" .

fibo-be-oac-cctl:isParentCompanyOf a owl:ObjectProperty ;
    rdfs:label "is parent company of" ;
    rdfs:domain fibo-be-oac-cctl:ControllingAffiliate ;
    rdfs:range fibo-be-oac-cctl:Subsidiary ;
    rdfs:subPropertyOf fibo-be-oac-cctl:isControllingAffiliateOf ;
    owl:inverseOf fibo-be-oac-cctl:isSubsidiaryOf ;
    skos:definition "indicates a controlled affiliate that it owns at least 50 percent of" .

fibo-be-oac-cown:Shareholder a owl:Class ;
    rdfs:label "shareholder" ;
    rdfs:subClassOf fibo-be-oac-opty:ConstitutionalOwner,
        fibo-fnd-agr-ctr:Counterparty ;
    skos:definition "party that owns shares in and has rights and responsibilities with respect to some asset, provided in exchange for investment" ;
    cmns-av:explanatoryNote "The shares represent an ownership interest in a corporation, mutual fund, or partnership, or a unit of ownership in a structured product, such as a real estate investment trust." ;
    cmns-av:synonym "stockholder"@en-US .

fibo-be-oac-cown:hasBeneficialOwner a owl:ObjectProperty ;
    rdfs:label "has beneficial owner" ;
    rdfs:domain fibo-fnd-oac-own:Asset ;
    rdfs:range fibo-be-oac-cown:BeneficialOwner ;
    rdfs:subPropertyOf fibo-fnd-oac-own:isAssetOf ;
    skos:definition "indicates the party that retains rights in the asset they own in a beneficial ownership situation" .

fibo-be-oac-cown:isBeneficialOwnerOf a owl:ObjectProperty ;
    rdfs:label "is beneficial owner of" ;
    rdfs:domain fibo-be-oac-cown:BeneficialOwner ;
    rdfs:range fibo-fnd-oac-own:Asset ;
    rdfs:subPropertyOf fibo-fnd-oac-own:ownsAsset ;
    owl:inverseOf fibo-be-oac-cown:hasBeneficialOwner ;
    skos:definition "indicates an asset in which the beneficial owner holds rights (typically voting rights, management rights, etc.) in a beneficial ownership situation" .

fibo-be-oac-exec:AuthorizedIndividual a owl:Class ;
    rdfs:label "authorized individual" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-bauth:ResponsibleParty ;
    skos:definition "role of an individual that has been given the responsibility to act on behalf of another party under some set of guidelines" .

fibo-be-oac-exec:BoardCapacity a owl:Class ;
    rdfs:label "board capacity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-law-lcap:isConferredOn ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-rlcmp:playsRole ;
                    owl:someValuesFrom fibo-be-oac-exec:BoardMember ] ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-oac-exec:CompanyLaw ;
            owl:onProperty cmns-rga:isGovernedBy ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( fibo-be-le-cb:InstrumentOfIncorporation fibo-be-oac-exec:Bylaws fibo-be-le-cb:BoardAgreement ) ] ],
        fibo-fnd-law-lcap:DelegatedLegalAuthority ;
    skos:definition "authority to act in a fiduciary capacity with respect to the organization, including but not limited to determining and executing corporate policy" .

fibo-be-oac-exec:BoardOfDirectors a owl:Class ;
    rdfs:label "board of directors" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-be-oac-exec:nominates ;
            owl:someValuesFrom fibo-be-oac-exec:CorporateOfficer ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty fibo-fnd-law-lcap:hasCapacity ;
                    owl:someValuesFrom fibo-be-oac-exec:BoardCapacity ] ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty cmns-col:hasMember ;
                    owl:someValuesFrom [ a owl:Restriction ;
                            owl:onProperty cmns-rlcmp:playsRole ;
                            owl:someValuesFrom fibo-be-oac-exec:BoardMember ] ] ],
        fibo-be-oac-cpty:EntityControllingParty ;
    skos:definition "group of people comprising the governing body of an organization that has the authority to set organizational strategy and policies as well as to select and, to some degree manage, leadership" ;
    cmns-av:explanatoryNote "For a public, for profit organization, its members (directors) are elected normally by the subscribers (stockholders) of the firm (generally at an annual general meeting) to govern the firm and look after the subscribers' interests. In the case of a not-for-profit organization, the board ensures the organization is acting in line with its mission. The board has the ultimate decision-making authority and, in general, is empowered to (1) set the company's policy, objectives, and overall direction, (2) adopt bylaws, (3) name members of the advisory, executive, finance, and other committees, (4) hire, monitor, evaluate, and fire the managing director and senior executives, (5) determine and pay the dividend, and (6) issue additional shares. Though all its members might not be engaged in the company's day-to-day operations, the entire board is held liable (under the doctrine of collective responsibility) for the consequences of the firm's policies, actions, and failures to act. Members of the board usually include senior-most executives (called inside directors or executive directors) as well as experts or respected persons chosen from the wider community (called outside directors or non-executive directors)." .

fibo-be-oac-exec:CompanyLaw a owl:Class ;
    rdfs:label "company law" ;
    rdfs:subClassOf fibo-fnd-law-cor:StatuteLaw ;
    skos:definition "legislation under which the formation, registration or incorporation, governance, and dissolution of a firm is administered and controlled" ;
    cmns-av:synonym "corporate law" .

fibo-be-oac-exec:ControllingNominee a owl:Class ;
    rdfs:label "controlling nominee"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-bauth:hasDelegatedControlOf ;
            owl:someValuesFrom fibo-fnd-oac-own:Asset ],
        cmns-bauth:LegallyDelegatedAuthority ;
    skos:definition "party that holds legal title to an asset (e.g., stocks, bonds, or property) on behalf of the beneficial owner" ;
    cmns-av:explanatoryNote "The nominee is typically the registered owner of an asset, named in official records." .

fibo-be-oac-exec:ExternalAuditor a owl:Class ;
    rdfs:label "external auditor" ;
    rdfs:subClassOf fibo-be-oac-exec:Auditor ;
    skos:definition "independent party qualified and authorized to examine and report on the accuracy of financial records and ensure that companies comply with tax laws" ;
    cmns-av:explanatoryNote "An external auditor is an individual or organization from outside the company, who typically is employed by an auditing firm that handles many different clients." .

fibo-be-oac-exec:designatesSignatory a owl:ObjectProperty ;
    rdfs:label "designates signatory" ;
    rdfs:range fibo-be-oac-exec:Signatory ;
    rdfs:subPropertyOf cmns-bauth:authorizes,
        cmns-org:designates ;
    skos:definition "authorizes to sign agreements, access accounts and/or perform other similar tasks" .

fibo-be-oac-exec:hasCorporateOfficer a owl:ObjectProperty ;
    rdfs:label "has corporate officer" ;
    rdfs:domain fibo-be-oac-cpty:ControlledParty ;
    rdfs:range fibo-be-oac-exec:CorporateOfficer ;
    rdfs:subPropertyOf fibo-fnd-oac-ctl:hasControllingParty ;
    skos:definition "indicates an officer of the organization" .

fibo-be-oac-exec:hasDirector a owl:ObjectProperty ;
    rdfs:label "has director" ;
    rdfs:domain fibo-be-oac-cpty:ControlledParty ;
    rdfs:range fibo-be-oac-exec:BoardMember ;
    rdfs:subPropertyOf fibo-fnd-oac-ctl:hasControllingParty ;
    skos:definition "indicates a member of the board of directors of the organization" .

fibo-be-oac-exec:hasResponsibility a owl:ObjectProperty ;
    rdfs:label "has responsibility" ;
    rdfs:domain cmns-pts:Party ;
    rdfs:range fibo-fnd-law-lcap:Duty ;
    rdfs:subPropertyOf fibo-fnd-law-lcap:hasCapacity ;
    skos:definition "specifies a commitment or obligation that an independent party has" .

fibo-be-oac-exec:isPrincipalPartyOf a owl:ObjectProperty ;
    rdfs:label "is principal party of" ;
    rdfs:domain fibo-be-oac-exec:PrincipalParty ;
    rdfs:range fibo-be-oac-cpty:ControlledParty ;
    rdfs:subPropertyOf fibo-be-oac-cpty:isControllingMemberOf ;
    skos:definition "identifies a legal entity (controlled party) over which a principal has some measure of control" .

fibo-be-oac-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Ownership and Control Module" ;
    dcterms:abstract "The ownership and control module contains ontologies that define various types and aspects of ownership and control as they apply among and between business entities. The ontologies in this module include the definition of types of party as defined in the roles of ownership and control along with the capacities which define those parties, and separately the relationships of ownership and control directly between organizations, which arise from the existence of those roles. Specific types of ownership and control relationships that are unique to incorporated companies are defined in addition to the more general terms to which these relate. Also included is an ontology of the types of control relationships that exist by virtue of the powers conferred upon corporate officers, board members and other executive roles." ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-27T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/OwnershipAndControl/MetadataBEOwnershipAndControl/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-oac-mod:OwnershipAndControlModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "ownership and control module" ;
    dcterms:abstract "The ownership and control module contains ontologies that define various types and aspects of ownership and control as they apply among and between business entities. The ontologies in this module include the definition of types of party as defined in the roles of ownership and control along with the capacities which define those parties, and separately the relationships of ownership and control directly between organizations, which arise from the existence of those roles. Specific types of ownership and control relationships that are unique to incorporated companies are defined in addition to the more general terms to which these relate. Also included is an ontology of the types of control relationships that exist by virtue of the powers conferred upon corporate officers, board members and other executive roles." ;
    dcterms:hasPart fibo-be-oac-cpty:,
        fibo-be-oac-cctl:,
        fibo-be-oac-cown:,
        fibo-be-oac-exec:,
        fibo-be-oac-opty: ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:title "FIBO BE Ownership and Control Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Ownership and Control Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-oac-opty:hasDirectOwnership a owl:ObjectProperty ;
    rdfs:label "has direct ownership" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fibo-be-le-fbo:NotForProfitOrganization fibo-be-le-lp:BusinessEntity cmns-org:LegalEntity ) ] ;
    rdfs:range fibo-be-oac-opty:EntityOwnership ;
    rdfs:subPropertyOf cmns-pts:experiences ;
    owl:inverseOf fibo-be-oac-opty:hasOwnedEntity ;
    skos:definition "relates a formal organization to the situation in which it is owned directly by another entity" .

fibo-be-oac-opty:hasInvestmentEntity a owl:ObjectProperty ;
    rdfs:label "has investment entity" ;
    owl:propertyChainAxiom ( fibo-be-oac-opty:hasInvestmentOwnership fibo-be-oac-opty:hasOwnedEntity ) ;
    skos:definition "relates a legal person to a directly owned formal organization or subsidiary, depending on the percent ownership interest" .

fibo-be-oac-opty:hasInvestmentOwnership a owl:ObjectProperty ;
    rdfs:label "has investment ownership" ;
    rdfs:domain cmns-org:LegalPerson ;
    rdfs:range fibo-be-oac-opty:EntityOwnership ;
    rdfs:subPropertyOf cmns-pts:playsActiveRoleIn ;
    owl:inverseOf fibo-be-oac-opty:hasOwningEntity ;
    skos:definition "relates a legal person to the context in which it owns a formal organization" .

fibo-be-ptr-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Partnerships Module" ;
    dcterms:abstract "The partnerships module contains ontologies that define concepts relating to types of partnerships, including incorporated and non-incorporated organizations. Partnerships are defined without reference to jurisdiction-specific legal forms. The abstractions distinguish between types of partnerships and related formation characteristics, as well as kinds of partners and types of partnership equity." ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-27T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/Partnerships/MetadataBEPartnerships/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-ptr-mod:PartnershipsModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "partnerships module" ;
    dcterms:abstract "The partnerships module contains ontologies that define concepts relating to types of partnerships, including incorporated and non-incorporated organizations. Partnerships are defined without reference to jurisdiction-specific legal forms. The abstractions distinguish between types of partnerships and related formation characteristics, as well as kinds of partners and types of partnership equity." ;
    dcterms:hasPart fibo-be-ptr-ptr: ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:title "FIBO BE Partnerships Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Partnerships Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-plc-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Private Limited Companies Module" ;
    dcterms:abstract "The private limited companies module defines business entities that are hybrid in nature, having certain characteristics of both a corporation and a partnership or sole proprietorship." ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-27T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/PrivateLimitedCompanies/MetadataBEPrivateLimitedCompanies/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-plc-mod:PrivateLimitedCompaniesModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "private limited companies module" ;
    dcterms:abstract "The private limited companies module defines business entities that are hybrid in nature, having certain characteristics of both a corporation and a partnership or sole proprietorship." ;
    dcterms:hasPart fibo-be-plc-plc: ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:title "FIBO BE Private Limited Companies Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Private Limited Companies Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-plc-plc:isManagingMemberOf a owl:ObjectProperty ;
    rdfs:label "is managing member of" ;
    rdfs:domain fibo-be-plc-plc:ManagingMember ;
    rdfs:subPropertyOf fibo-be-oac-cpty:isControllingMemberOf ;
    owl:inverseOf fibo-be-plc-plc:hasManagingMember ;
    skos:definition "indicates the controlled limited liability company that the managing member runs" .

fibo-be-sps-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Sole Proprietorships Module" ;
    dcterms:abstract "The sole proprietorships module includes ontologies describing business entities or financial ventures that are carried out by a single person who is directly responsible for all liabilities of that venture." ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-27T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/SoleProprietorships/MetadataBESoleProprietorships/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-sps-mod:SoleProprietorshipsModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "sole proprietorships module" ;
    dcterms:abstract "The sole proprietorships module includes ontologies describing business entities or financial ventures that are carried out by a single person who is directly responsible for all liabilities of that venture." ;
    dcterms:hasPart fibo-be-sps-sps: ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:title "FIBO BE Sole Proprietorships Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Sole Proprietorships Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-tr-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Trusts Module" ;
    dcterms:abstract "The trusts module defines types of trusts as formally constituted organizations with specific parties as set down in law for trusts (trustor, trustee and beneficiary), each of these being signatories to a trust agreement." ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-27T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/Trusts/MetadataBETrusts/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-tr-mod:TrustsModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "trusts module" ;
    dcterms:abstract "The trusts module defines types of trusts as formally constituted organizations with specific parties as set down in law for trusts (trustor, trustee and beneficiary), each of these being signatories to a trust agreement." ;
    dcterms:hasPart fibo-be-tr-tr: ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:title "FIBO BE Trusts Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Trusts Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-tr-tr:isTrusteeOf a owl:ObjectProperty ;
    rdfs:label "is trustee of" ;
    rdfs:domain fibo-be-tr-tr:Trustee ;
    rdfs:range fibo-be-tr-tr:Trust ;
    rdfs:subPropertyOf cmns-pts:actsOn ;
    skos:definition "identifies the trust over which a trustee has some measure of control" .

fibo-fnd-aap-ppl:NationalIdentificationNumber a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-ge-ge:Government ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

fibo-fnd-pty-pty:TaxIdentifier a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( cmns-org:OrganizationIdentifier fibo-fnd-aap-ppl:NationalIdentificationNumber ) ] .

fibo-be-fct-fct:Merchant a owl:Class ;
    rdfs:label "merchant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-cls:isClassifiedBy ;
            owl:someValuesFrom fibo-be-fct-fct:MerchantCategoryCode ],
        [ a owl:Restriction ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:someValuesFrom fibo-be-fct-fct:MerchantIdentifier ],
        fibo-be-fct-fct:FunctionalBusinessEntity ;
    skos:definition "party engaged in the purchase and sales of goods produced by others for profit" .

fibo-be-fct-pub: a owl:Ontology ;
    rdfs:label "Publishers Ontology" ;
    dcterms:abstract "The concept of a publisher is central to the notion of a data provider in financial markets. This ontology defines the fundamental concepts for publishers of information, including entities whose primary function is to publish, and those (whether or not they are publishers in that sense) that play the role of the publisher of some information." ;
    dcterms:license """2013-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.
		
Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av:,
        cmns-doc:,
        cmns-pts:,
        cmns-rlcmp: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20260601/FunctionalEntities/Publishers/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/BE/20140501/FunctionalEntities/Publishers.rdf version of this ontology was modified per the issue resolutions identified in the FIBO BE 1.0 FTF report.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20160201/FunctionalEntities/Publishers.rdf version of this ontology was modified per the FIBO 2.0 RFC.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20180801/FunctionalEntities/Publishers.rdf version of this ontology was modified to eliminate references to external dictionary sites that no longer resolve.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20210101/FunctionalEntities/Publishers.rdf version of this ontology was modified to deprecate publishing house rather than having two disconnected concepts, clean up the related restrictions, and add market data provider (originally in IND).",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20221001/FunctionalEntities/Publishers.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary and revise definitions to be ISO 704 compliant as needed.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230101/FunctionalEntities/Publishers.rdf version of the ontology was modified to eliminate deprecations that are more than 6 months old.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20231101/FunctionalEntities/Publishers.rdf version of the ontology was modified to replace concepts from several FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20231201/FunctionalEntities/Publishers.rdf version of the ontology was modified to replace additional concepts from several FIBO FND ontologies with their counterparts added to the Commons Ontology Library (Commons) v1.1.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20250301/FunctionalEntities/Publishers.rdf version of the ontology was modified to loosen various constraints to better reflect use case requirements (SEC-205).",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20260101/FunctionalEntities/Publishers.rdf version of the ontology was modified to add market data provider discrimination required for examples (FND-407)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2013-2025 Object Management Group, Inc.",
        "Copyright (c) 2013-2026 EDM Association dba EDM Council, Inc." .

fibo-be-ge-casj:GovernmentOfTheKyrgyzRepublic a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Kyrgyz Republic"@en,
        "Кыргыз Республикасы"@ky ;
    skos:definition "unitary parliamentary secular constitutional republic in Central Asia, bordered by Kazakhstan, Uzbekistan, Tajikistan, and China" ;
    cmns-rga:governs lcc-3166-1:Kyrgyzstan ;
    cmns-rga:hasJurisdiction fibo-be-ge-casj:JurisdictionOfTheKyrgyzRepublic .

fibo-be-ge-casj:GovernmentOfTheRepublicOfKazakhstan a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Kazakhstan"@en,
        "Қазақстан Республикасы"@kk ;
    skos:definition "unitary dominant-party presidential constitutional republic in Central Asia, bordered by Russia in the north, China in the east, and Kyrgyzstan, Uzbekistan, and Turkmenistan in the south while also adjoining a large part of the Caspian Sea in the southwest" ;
    cmns-rga:governs lcc-3166-1:Kazakhstan ;
    cmns-rga:hasJurisdiction fibo-be-ge-casj:JurisdictionOfTheRepublicOfKazakhstan .

fibo-be-ge-casj:GovernmentOfTheRepublicOfTajikistan a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Tajikistan"@en,
        "Ҷумҳурии Тоҷикистон"@tg ;
    skos:definition "unitary dominant-party presidential constitutional secular republic in Central Asia, bordered by Afghanistan to the south, Uzbekistan to the west, Kyrgyzstan to the north and China to the east" ;
    cmns-rga:governs lcc-3166-1:Tajikistan ;
    cmns-rga:hasJurisdiction fibo-be-ge-casj:JurisdictionOfTheRepublicOfTajikistan .

fibo-be-ge-casj:GovernmentOfTheRepublicOfUzbekistan a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Uzbekistan"@en,
        "Oʻzbekiston Respublikasi"@uz ;
    skos:definition "unitary presidential constitutional secular republic in Central Asia, bordered by Kazakhstan to the north, Kyrgyzstan to the northeast, Tajikistan to the southeast, Afghanistan to the south, Turkmenistan and the autonomous republic of Karakalpakstan to the south-west" ;
    cmns-rga:governs lcc-3166-1:Uzbekistan ;
    cmns-rga:hasJurisdiction fibo-be-ge-casj:JurisdictionOfTheRepublicOfUzbekistan .

fibo-be-ge-casj:GovernmentOfTurkmenistan a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Turkmenistan"@en,
        "Türkmenistan"@tk ;
    skos:definition "unitary dominant-party presidential republic in Central Asia, bordered by Kazakhstan to the northwest, Uzbekistan to the north, east and northeast, Afghanistan to the southeast, Iran to the south and southwest and the Caspian Sea to the west" ;
    cmns-rga:governs lcc-3166-1:Turkmenistan ;
    cmns-rga:hasJurisdiction fibo-be-ge-casj:JurisdictionOfTurkmenistan .

fibo-be-ge-easj:GovernmentOfJapan a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Japan"@en,
        "日本国"@ja ;
    skos:definition "unitary parliamentary constitutional monarchy with a bicameral legislature in Eastern Asia, bordered on the west by the Sea of Japan, and extending from the Sea of Okhotsk in the north toward the East China Sea and Taiwan in the south" ;
    cmns-rga:governs lcc-3166-1:Japan ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfJapan .

fibo-be-ge-easj:GovernmentOfMongolia a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of Mongolia"@en,
        "Монгол Улс"@mn ;
    skos:definition "unitary semi-presidential representative democratic republic and landlocked country in Eastern Asia, situated between Russia to the north and China to the south, where it neighbours the Inner Mongolia Autonomous Region" ;
    cmns-rga:governs lcc-3166-1:Mongolia ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfMongolia .

fibo-be-ge-easj:GovernmentOfTheDemocraticPeoplesRepublicOfKorea a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Democratic People's Republic of Korea"@en,
        "조선민주주의인민공화국"@ko ;
    skos:definition "unitary one-party republic under a totalitarian dictatorship in Eastern Asia, constituting the northern part of the Korean Peninsula, bordered to the north by China and by Russia along the Amnok (known as the Yalu in Chinese) and Tumen rivers, and to the south by South Korea, with the heavily fortified Korean Demilitarized Zone (DMZ) separating the two" ;
    cmns-rga:governs lcc-3166-1:KoreaDemocraticPeoplesRepublicOf ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfTheDemocraticPeoplesRepublicOfKorea .

fibo-be-ge-easj:GovernmentOfTheHongKongSpecialAdministrativeRegionOfThePeoplesRepublicOfChina a owl:NamedIndividual,
        fibo-be-ge-ge:RegionalGovernment ;
    rdfs:label "Government of the Hong Kong Special Administrative Region of the People's Republic of China"@en,
        "中華人民共和國香港特別行政區"@zh ;
    skos:definition "devolved executive-led system within a socialist republic that is a metropolitan area and special administrative region of the People's Republic of China on the eastern Pearl River Delta of the South China Sea" ;
    cmns-rga:governs lcc-3166-1:HongKong ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfHongKong .

fibo-be-ge-easj:GovernmentOfTheMacaoSpecialAdministrativeRegionOfThePeoplesRepublicOfChina a owl:NamedIndividual,
        fibo-be-ge-ge:RegionalGovernment ;
    rdfs:label "Government of the Macao Special Administrative Region of the People's Republic of China"@en,
        "中華人民共和國澳門特別行政區"@zh ;
    skos:definition "devolved executive-led system within a socialist republic that is a metropolitan area and special administrative region of the People's Republic of China in the western Pearl River Delta by the South China Sea" ;
    cmns-rga:governs lcc-3166-1:Macao ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfMacao .

fibo-be-ge-easj:GovernmentOfThePeoplesRepublicOfChina a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the People's Republic of China"@en,
        "中华人民共和国"@zh ;
    skos:definition "unitary Marxist-Leninist single-party socialist republic in Eastern Asia, covering approximately 9.6 million square kilometers (3.7 million square miles), that is the world's third or fourth-largest country by area" ;
    cmns-rga:governs lcc-3166-1:China ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfChina .

fibo-be-ge-easj:GovernmentOfTheRepublicOfChina a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of China"@en,
        "中華民國"@zh ;
    skos:definition "unitary semi-presidential constitutional republic whose neighbors include the People's Republic of China (PRC) to the northwest, Japan to the northeast, and the Philippines to the south" ;
    cmns-rga:governs lcc-3166-1:Taiwan ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfTheRepublicOfChina .

fibo-be-ge-easj:GovernmentOfTheRepublicOfKorea a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Korea"@en,
        "대한민국"@ko ;
    skos:definition "unitary presidential constitutional republic in Eastern Asia, constituting the southern part of the Korean Peninsula, and sharing a land border with North Korea" ;
    cmns-rga:governs lcc-3166-1:KoreaRepublicOf ;
    cmns-rga:hasJurisdiction fibo-be-ge-easj:JurisdictionOfTheRepublicOfKorea .

fibo-be-ge-seasj:GovernmentOfMalaysia a owl:NamedIndividual,
        fibo-be-ge-ge:FederalGovernment ;
    rdfs:label "Government of Malaysia"@en ;
    skos:definition "federal parliamentary constitutional elective monarchy in Southeastern Asia, separated by the South China Sea into two regions, Peninsular Malaysia and Borneo's East Malaysia, that shares land and maritime borders with Thailand, Brunei, and Indonesia, and maritime borders with Singapore, Vietnam, and the Philippines" ;
    cmns-rga:governs lcc-3166-1:Malaysia ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfMalaysia .

fibo-be-ge-seasj:GovernmentOfTheDemocraticRepublicOfTimor-Leste a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Democratic Republic of Timor-Leste"@en,
        "República Democrática de Timor-Leste"@pt,
        "Repúblika Demokrátika Timór-Leste"@tet ;
    skos:definition "unitary semi-presidential constitutional republic in Southeastern Asia, an island country that comprises the eastern half of the island of Timor, the nearby islands of Atauro and Jaco, and Oecusse, an exclave on the northwestern side of the island surrounded by Indonesian West Timor" ;
    cmns-rga:governs lcc-3166-1:Timor-Leste ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfTheDemocraticRepublicOfTimor-Leste .

fibo-be-ge-seasj:GovernmentOfTheKingdomOfCambodia a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Kingdom of Cambodia"@en ;
    skos:definition "unitary dominant-party parliamentary elective constitutional monarchy in Southeastern Asia, located in the southern portion of the Indochinese peninsula, bordered by Thailand to the northwest, Laos to the northeast, Vietnam to the east and the Gulf of Thailand to the southwest" ;
    cmns-rga:governs lcc-3166-1:Cambodia ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfCambodia .

fibo-be-ge-seasj:GovernmentOfTheLaoPeoplesDemocraticRepublic a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Lao People's Democratic Republic"@en,
        "ສາທາລະນະລັດ ປະຊາທິປະໄຕ ປະຊາຊົນລາວ"@lo ;
    skos:definition "unitary Marxist-Leninist one-party socialist republic in Southeastern Asia, located on the Indochinese Peninsula, bordered by Myanmar and China to the northwest, Vietnam to the east, Cambodia to the southeast and Thailand to the west and southwest" ;
    cmns-rga:governs lcc-3166-1:LaoPeoplesDemocraticRepublic ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfTheLaoPeoplesDemocraticRepublic .

fibo-be-ge-seasj:GovernmentOfTheNationOfBruneiTheAbodeOfPeace a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Nation of Brunei, the Abode of Peace"@en,
        "Negara Brunei Darussalam"@ms ;
    skos:definition "unitary Islamic absolute monarchy in Southeastern Asia, located on the north coast of the island of Borneo" ;
    cmns-rga:governs lcc-3166-1:BruneiDarussalam ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfBrunei .

fibo-be-ge-seasj:GovernmentOfTheRepublicOfIndonesia a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Indonesia"@en,
        "Republik Indonesia"@id ;
    skos:definition "unitary presidential constitutional republic in Southeastern Asia, consisting of more than seventeen thousand islands, including Sumatra, Java, Sulawesi, and parts of Borneo and New Guinea, located between the Indian and Pacific oceans" ;
    cmns-rga:governs lcc-3166-1:Indonesia ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfIndonesia .

fibo-be-ge-seasj:GovernmentOfTheRepublicOfSingapore a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of Singapore"@en,
        "Republik Singapura"@ms,
        "சிங்கப்பூர் குடியரசு"@ta,
        "新加坡共和国"@zh ;
    skos:definition "unitary dominant-party parliamentary constitutional republic in Southeastern Asia, located off the southern tip of the Malay Peninsula, bordering the Straits of Malacca to the west, the Riau Islands (Indonesia) to the south, and the South China Sea to the east" ;
    cmns-rga:governs lcc-3166-1:Singapore ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfTheRepublicOfSingapore .

fibo-be-ge-seasj:GovernmentOfTheRepublicOfThePhilippines a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of the Philippines"@en,
        "Republika ng Pilipinas"@tl ;
    rdfs:seeAlso <https://www.gov.ph/> ;
    skos:definition "unitary presidential constitutional republic in Southeastern Asia, an archipelagic country bordered by the South China Sea to the west, the Philippine Sea to the east, and the Celebes Sea to the southwest, and shares maritime borders with Taiwan to the north, Japan to the northeast, Palau to the east and southeast, Indonesia to the south, Malaysia and Brunei to the southwest, Vietnam to the west, and China to the northwest" ;
    cmns-rga:governs lcc-3166-1:Philippines ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfTheRepublicOfThePhilippines .

fibo-be-ge-seasj:GovernmentOfTheRepublicOfTheUnionOfMyanmar a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Republic of the Union of Myanmar"@en,
        "ပြည်ထောင်စု သမ္မတ မြန်မာနိုင်ငံတော်"@my ;
    skos:definition "unitary parliamentary assembly-independent republic under a military junta in Southeastern Asia, bordered by Bangladesh and India to its northwest, China to its northeast, Laos and Thailand to its east and southeast, and the Andaman Sea and the Bay of Bengal to its south and southwest" ;
    cmns-rga:governs lcc-3166-1:Myanmar ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfTheRepublicOfTheUnionOfMyanmar .

fibo-be-ge-seasj:GovernmentOfTheSocialistRepublicOfVietNam a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Socialist Republic of Viet Nam"@en,
        "Cộng hòa Xã hội chủ nghĩa Việt Nam"@vi ;
    skos:definition "unitary Marxist-Leninist one-party socialist republic in Southeastern Asia, located at the eastern edge of the Indochinese Peninsula, bordering China to the north, and Laos and Cambodia to the west; while maintaining maritime borders with Thailand through the Gulf of Thailand, and the Philippines, Indonesia and Malaysia through the South China Sea" ;
    cmns-rga:governs lcc-3166-1:VietNam ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfTheSocialistRepublicOfVietNam .

fibo-be-ge-seasj:RoyalThaiGovernment a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Royal Thai Government"@en,
        "รัฐบาลไทย"@th ;
    skos:definition "unitary military-junta constitutional monarchy in Southeastern Asia, bordered to the north by Myanmar and Laos, to the east by Laos and Cambodia, to the south by the Gulf of Thailand and Malaysia, and to the west by the Andaman Sea and the southern extremity of Myanmar, and sharing maritime borders with Vietnam in the Gulf of Thailand to the southeast, and Indonesia and India on the Andaman Sea to the southwest" ;
    cmns-rga:governs lcc-3166-1:Thailand ;
    cmns-rga:hasJurisdiction fibo-be-ge-seasj:JurisdictionOfTheRoyalThaiGovernment .

fibo-be-ge-sasj:GovernmentOfTheDemocraticSocialistRepublicOfSriLanka a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Democratic Socialist Republic of Sri Lanka"@en,
        "ශ්‍රී ලංකා ප්‍රජාතාන්ත්‍රික සමාජවාදී ජනරජය"@si ;
    rdfs:seeAlso <http://www.gov.lk/> ;
    skos:definition "unitary semi-presidential constitutional republic in Southern Asia that is an island country situated on the Indian Ocean, southwest of the Bay of Bengal, and southeast of the Arabian Sea" ;
    cmns-rga:governs lcc-3166-1:SriLanka ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfSriLanka .

fibo-be-ge-sasj:GovernmentOfTheFederalDemocraticRepublicOfNepal a owl:NamedIndividual,
        fibo-be-ge-ge:FederalGovernment ;
    rdfs:label "Government of the Federal Democratic Republic of Nepal"@en,
        "सङ्घीय लोकतान्त्रिक गणतन्त्र नेपाल"@ne ;
    skos:definition "federal parliamentary republic in Southern Asia, mainly situated in the Himalayas, bordering Tibet of China to the north, and India in the south, east, and west" ;
    cmns-rga:governs lcc-3166-1:Nepal ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfNepal .

fibo-be-ge-sasj:GovernmentOfTheIslamicRepublicOfAfghanistan a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Islamic Republic of Afghanistan"@en,
        "Da Afġānistān Islāmī Jumhoryat"@ps ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Politics_of_Afghanistan> ;
    skos:definition "unitary presidential Islamic republic in Southern Asia, bordered by Pakistan to the east and south, Iran to the west, Turkmenistan, Uzbekistan, and Tajikistan to the north, and China to the northeast" ;
    cmns-rga:governs lcc-3166-1:Afghanistan ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfAfghanistan .

fibo-be-ge-sasj:GovernmentOfTheIslamicRepublicOfIran a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "Government of the Islamic Republic of Iran"@en,
        "جمهوری اسلامی ایران"@fa ;
    rdfs:seeAlso <http://www.icana.ir/> ;
    skos:definition "unitary Khomeinist presidential Islamic republic in Southern Asia, bordered to the northwest by Armenia and Azerbaijan, to the north by the Caspian Sea, to the northeast by Turkmenistan, to the east by Afghanistan, to the southeast by Pakistan, to the south by the Persian Gulf and the Gulf of Oman, and to the west by Turkey and Iraq" ;
    cmns-rga:governs lcc-3166-1:Iran ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfIran .

fibo-be-ge-sasj:GovernmentOfTheIslamicRepublicOfPakistan a owl:NamedIndividual,
        fibo-be-ge-ge:FederalGovernment ;
    rdfs:label "Government of the Islamic Republic of Pakistan"@en,
        "اِسلامی جمہوریہ پاكِستان"@ur ;
    rdfs:seeAlso <http://www.pakistan.gov.pk/> ;
    skos:definition "federal parliamentary constitutional republic in Southern Asia, bordered by India to the east, Afghanistan to the west, Iran to the southwest, and China to the northeast" ;
    cmns-rga:governs lcc-3166-1:Pakistan ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfPakistan .

fibo-be-ge-sasj:GovernmentOfTheKingdomOfBhutan a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "འབྲུག་རྒྱལ་ཁབ་"@dz,
        "Government of the Kingdom of Bhutan"@en ;
    skos:definition "unitary parliamentary constitutional monarchy in Southern Asia, bordered by China to the north and India to the south" ;
    cmns-rga:governs lcc-3166-1:Bhutan ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfBhutan .

fibo-be-ge-sasj:GovernmentOfThePeoplesRepublicOfBangladesh a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "গণপ্রজাতন্ত্রী বাংলাদেশ"@bn,
        "Government of the People's Republic of Bangladesh"@en ;
    rdfs:seeAlso <http://bangladesh.gov.bd/> ;
    skos:definition "unitary dominant-party parliamentary constitutional republic in Southern Asia, bordered by India to the west, north, and east, Myanmar to the southeast, and the Bay of Bengal to the south" ;
    cmns-rga:governs lcc-3166-1:Bangladesh ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfBangladesh .

fibo-be-ge-sasj:GovernmentOfTheRepublicOfIndia a owl:NamedIndividual,
        fibo-be-ge-ge:FederalGovernment ;
    rdfs:label "Government of the Republic of India"@en,
        "Bhārat Gaṇarājya"@hi ;
    rdfs:seeAlso <http://parliamentofindia.nic.in/> ;
    skos:definition "federal parliamentary constitutional and democratic republic in Southern Asia, bordered by the Indian Ocean on the south, the Arabian Sea on the southwest, and the Bay of Bengal on the southeast, it shares land borders with Pakistan to the northwest; China, Nepal, and Bhutan to the north; and Bangladesh and Myanmar to the east" ;
    cmns-rga:governs lcc-3166-1:India ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfIndia .

fibo-be-ge-sasj:GovernmentOfTheRepublicOfMaldives a owl:NamedIndividual,
        fibo-be-ge-ge:NationalGovernment ;
    rdfs:label "ދިވެހިރާއްޖެ"@dv,
        "Government of the Republic of Maldives"@en ;
    skos:definition "unitary presidential republic in Southern Asia, a small archipelagic state situated in the Indian Ocean" ;
    cmns-rga:governs lcc-3166-1:Maldives ;
    cmns-rga:hasJurisdiction fibo-be-ge-sasj:JurisdictionOfMaldives .

fibo-be-ge-wasj: a owl:Ontology ;
    rdfs:label "Western Asia Government Entities and Jurisdictions Ontology" ;
    dcterms:abstract "This ontology provides government entities and jurisdictions for countries that are defined as being part of Western Asia in the U.N. M49 codes, primarily those that are considered independent countries in ISO 3166, or are important from a banking perspective." ;
