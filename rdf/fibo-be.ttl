fibo-be-ge-cbj: a owl:Ontology ;
    rdfs:label "Caribbean Government Entities and Jurisdictions Ontology" ;
    dcterms:abstract "This ontology provides the set of basic government-level entities and jurisdictions for independent countries and British Commonwealth regional sovereignties identified as part of the Caribbean in the U.N. M49 classification." ;
