        lcc-3166-1:SaintPierreAndMiquelon,
        lcc-3166-1:WallisAndFutuna ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-weuj:GovernmentOfTheFrenchRepublic .

fibo-be-ge-weuj:GermanEntity a owl:NamedIndividual,
