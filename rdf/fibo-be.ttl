        lcc-3166-2-us:UnitedStatesMinorOutlyingIslands,
        lcc-3166-2-us:Utah,
        lcc-3166-2-us:Vermont,
        lcc-3166-2-us:VirginIslands,
        lcc-3166-2-us:Virginia,
        lcc-3166-2-us:Washington,
        lcc-3166-2-us:WestVirginia,
        lcc-3166-2-us:Wisconsin,
        lcc-3166-2-us:Wyoming ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-usj:UnitedStatesGovernment .

fibo-be-ge-usj:VirginIslandsEntity a owl:NamedIndividual,
        fibo-be-ge-ge:RegionalSovereignty ;
    rdfs:label "Virgin Islands entity (USA)" ;
    rdfs:isDefinedBy fibo-be-ge-usj: ;
    rdfs:seeAlso <http://www.vi.gov/>,
        <https://en.wikipedia.org/wiki/United_States_Virgin_Islands>,
        <https://www.doi.gov/oia/islands/virgin-islands> ;
    skos:definition "individual representing the unincorporated territory and polity for the Virgin Islands (USA)" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-2-us:VirginIslands ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-usj:GovernmentOfVirginIslands .

fibo-be-le-cb:BenefitCorporation a owl:Class ;
    rdfs:label "benefit corporation" ;
    rdfs:subClassOf fibo-be-le-cb:NotForProfitCorporation ;
    skos:definition "not-for-profit corporation set up under specific state legislation, typically to provide some social benefit, without an obligation to maximize shareholder return" ;
    cmns-av:explanatoryNote "This is a US-specific type of non-profit corporation defined in recent legislation in a number of states. In California, for example, benefit corporations may be defined as public benefit or mutual benefit corporations, depending on their purpose." .

fibo-be-le-cb:CommonInterestDevelopmentCorporation a owl:Class ;
    rdfs:label "common interest development corporation" ;
    rdfs:subClassOf fibo-be-le-cb:NotForProfitCorporation ;
    skos:definition "not-for-profit corporation set up under specific state legislation as a business entity for homeowners' associations" ;
    skos:example "http://www.dre.ca.gov/files/pdf/re39.pdf"^^xsd:anyURI ;
    cmns-av:explanatoryNote "A common interest development is typically a type of housing, composed of individually owned units, such as condominiums, townhouses, or single-family homes, that share ownership of common areas, such as swimming pools, landscaping, and parking. Common interest developments (also known as community interest developments or CIDs) are managed by homeowners' associations." .

fibo-be-le-cb:ForProfitCorporation a owl:Class ;
    rdfs:label "for profit corporation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-le-lp:ProfitObjective ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ],
        fibo-be-le-cb:Corporation ;
    owl:disjointWith fibo-be-le-cb:NotForProfitCorporation ;
    skos:definition "corporation whose objective is to make money, i.e., to ensure realization of a financial benefit such that the amount of revenue gained from a business activity exceeds the expenses, costs and taxes needed to sustain that activity" .

fibo-be-le-cb:IncorporationGuarantee a owl:Class ;
    rdfs:label "incorporation guarantee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-fnd-acc-cur:MonetaryAmount ;
            owl:onProperty fibo-fnd-acc-cur:hasNotionalAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty cmns-org:isProvidedBy ],
        fibo-fnd-law-cor:Constitution ;
    skos:definition "guarantee that is part of the financial basis by which some legal entity is incorporated" .

fibo-be-le-fbo:Branch a owl:Class ;
    rdfs:label "branch" ;
    rdfs:subClassOf cmns-org:OrganizationalSubUnit ;
    skos:definition "part of a larger organization that might not be co-located with it" .

fibo-be-le-fbo:Division a owl:Class ;
    rdfs:label "division" ;
    rdfs:subClassOf cmns-org:OrganizationalSubUnit ;
    skos:definition "part of an organization, such as a line of business, that may have separate accounting and reporting requirements" .

fibo-be-le-fbo:NonGovernmentalOrganization a owl:Class ;
    rdfs:label "non-governmental organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-le-lp:PublicPurpose ;
            owl:onProperty fibo-fnd-gao-obj:hasObjective ],
        fibo-be-le-fbo:NotForProfitOrganization ;
    skos:definition "not-for-profit organization that functions independently of government" ;
    cmns-av:abbreviation "NGO" ;
    cmns-av:explanatoryNote "NGOs, sometimes called civil societies, are organized on community, national and international levels to serve specific social or political purposes, and are cooperative, rather than commercial, in nature.",
        "Some NGOs avoid formal funding altogether and are run primarily by volunteers. NGOs are highly diverse groups of organizations engaged in a wide range of activities, and take different forms in different parts of the world. Some may have charitable status, while others may be registered for tax exemption based on recognition of social purposes. Others may be fronts for political, religious, or other interests." .

fibo-be-le-fbo:ValueAddedTaxIdentificationNumber a owl:Class ;
    rdfs:label "value-added tax identification number" ;
    rdfs:subClassOf fibo-fnd-pty-pty:TaxIdentifier,
        cmns-org:OrganizationIdentifier ;
    skos:definition "tax identifier that identifies a taxable person (business) or non-taxable legal entity for a consumption tax that is assessed incrementally, levied on the price of a product or service at each stage of production, distribution, and sale to the end consumer" ;
    cmns-av:abbreviation "VATIN" ;
    cmns-av:adaptedFrom "https://ec.europa.eu/taxation_customs/business/vat/eu-vat-rules-topic/vat-identification-numbers_en"^^xsd:anyURI ;
    cmns-av:explanatoryNote "If the ultimate consumer is a business that collects and pays to the government VAT on its products or services, it can reclaim the tax paid. Not all localities require VAT to be charged, and exports are often exempt. VAT is usually implemented as a destination-based tax, where the tax rate is based on the location of the consumer and applied to the sales price." ;
    cmns-av:synonym "VAT identification number",
        "VAT registration number" .

fibo-be-le-fbo:hasEquity a owl:ObjectProperty ;
    rdfs:label "has equity" ;
    rdfs:domain cmns-org:LegalEntity ;
    rdfs:range fibo-fnd-oac-own:OwnersEquity ;
    rdfs:subPropertyOf cmns-qtu:hasExpression ;
    skos:definition "indicates owners' equity associated with the entity" .

fibo-be-le-fbo:hasHeadquartersAddress a owl:ObjectProperty ;
    rdfs:label "has headquarters address" ;
    rdfs:range fibo-fnd-plc-adr:PhysicalAddress ;
    rdfs:subPropertyOf fibo-be-le-fbo:hasOperatingAddress ;
    skos:definition "indicates the main address at which communications may be delivered for the organization" ;
    cmns-av:adaptedFrom "https://www.gleif.org/en/about-lei/common-data-file-format/lei-cdf-format/lei-cdf-format-version-2-1"^^xsd:anyURI .

fibo-be-le-lei:AccountingPeriod a owl:NamedIndividual,
        fibo-be-le-lei:RelationshipPeriodQualifier ;
    rdfs:label "accounting period" ;
    skos:definition "qualifier indicating that the relationship period reflects the period of time covered by the most recent validation documents from an accounting perspective for this relationship" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:ContractuallyCapableEntity a owl:Class ;
    rdfs:label "contractually capable entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cmns-org:LegalEntity ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-pts:AgentRole ;
    skos:definition "a unique entity that is legally or financially responsible for the performance of financial transactions, or has the legal right in its jurisdiction to enter independently into legal contracts, regardless of whether it is incorporated or constituted in some other way (e.g. trust, partnership, contractual). This excludes natural persons, but includes governmental organizations and supranationals." ;
    cmns-av:adaptedFrom "ISO 17442" .

fibo-be-le-lei:DocumentFilingPeriod a owl:NamedIndividual,
        fibo-be-le-lei:RelationshipPeriodQualifier ;
    rdfs:label "document filing period" ;
    skos:definition "a qualifier indicating that the relationship period reflects the validity period for any regulatory filing, accounting document, other document demonstrating the relationship's validity" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:GenerallyAcceptedAccountingPrinciples a owl:NamedIndividual,
        fibo-be-le-lei:AccountingFramework ;
    rdfs:label "Generally Accepted Accounting Principles" ;
    rdfs:seeAlso <https://www.fasb.org/home> ;
    skos:definition "an accounting framework developed by the US Financial Accounting Standards Board (FASB)" ;
    cmns-av:abbreviation "GAAP",
        "US GAAP" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:ISO17442-CodeSet a owl:NamedIndividual,
        fibo-be-le-lei:LegalEntityIdentifierScheme ;
    rdfs:label "ISO 17442 code set" ;
    skos:definition "the set of legal entity identifiers that comprise the ISO 17442 legal entity identifier specification" ;
    cmns-av:synonym "GLEIF LEI CDF v2.1 legal entity identifier (LEI) code set" .

fibo-be-le-lei:ISO20275-CodeSet a owl:NamedIndividual,
        fibo-be-le-lei:EntityLegalFormScheme ;
    rdfs:label "ISO 20275 code set" ;
    skos:definition "the set of entity legal form identifiers that comprise the ISO 20275 entity legal form specification" ;
    cmns-av:synonym "entity legal form (ELF) code set" .

fibo-be-le-lei:InternationalFinancialReportingStandard a owl:NamedIndividual,
        fibo-be-le-lei:AccountingFramework ;
    rdfs:label "International Financial Reporting Standard" ;
    rdfs:seeAlso <https://www.ifrs.org/> ;
    skos:definition "an accounting framework developed by the International Accounting Standards Board (IASB)" ;
    cmns-av:abbreviation "IFRS" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:LEIRegisteredEntity a owl:Class ;
    rdfs:label "LEI registered entity" ;
    rdfs:subClassOf cmns-org:LegalPerson ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:someValuesFrom fibo-be-le-lei:LegalEntityIdentifier ] ;
    skos:definition "a legal person that has registered for and is identified by a legal entity identifier" ;
    cmns-av:explanatoryNote "Note that the GLEIF data includes multiple LEIs for some entities due to corporate actions or other situations. The duplicates are typically archived after some period of time, but in order to reflect the reality in the data, the restriction is modeled as someValuesFrom rather than exactly 1 LEI for a given entity." .

fibo-be-le-lei:OtherAccountingFramework a owl:NamedIndividual,
        fibo-be-le-lei:AccountingFramework ;
    rdfs:label "other accounting framework" ;
    rdfs:seeAlso <https://www.ifrs.org/> ;
    skos:definition "an accounting framework of unstated origin (other than IFRS or US GAAP)" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:RelationshipRecord a owl:Class ;
    rdfs:label "relationship record" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-be-le-lei:isQuantifiedBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-le-lei:RelationshipQualifier ;
            owl:onProperty fibo-fnd-agr-ctr:isQualifiedBy ],
        [ a owl:Restriction ;
            owl:onClass fibo-be-oac-opty:EntityOwnership ;
            owl:onProperty cmns-doc:records ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-col:Constituent ;
    skos:definition "a record describing relationships between legal entities" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:isConsolidationOf a owl:ObjectProperty ;
    rdfs:label "is consolidation of" ;
    rdfs:range cmns-org:LegalEntity ;
    rdfs:subPropertyOf cmns-col:comprises ;
    skos:definition "indicates the entity considered the 'start node' or consolidated entity from an ISO 17442 perspective" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:isDirectlyConsolidatedBy a owl:ObjectProperty ;
    rdfs:label "is directly consolidated by" ;
    rdfs:range cmns-org:LegalEntity ;
    rdfs:subPropertyOf fibo-be-le-lei:isConsolidatedBy ;
    skos:definition "indicates that the entity considered the 'end node' or consolidating entity (parent) fully consolidates the accounting of the 'start node' (child) per the accounting rules specified, and is the closest consolidating entity to that child in any applicable ownership hierarchy" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:isInternationalBranchOf a owl:ObjectProperty ;
    rdfs:label "is an international branch of" ;
    rdfs:range cmns-org:LegalEntity ;
    rdfs:subPropertyOf fibo-be-le-lei:isConsolidatedBy ;
    skos:definition "indicates that the entity considered the 'start node' or consolidated entity (child) is an international subsidiary of the 'end node' (parent) in the jurisdiction of the child" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lei:isUltimatelyConsolidatedBy a owl:ObjectProperty ;
    rdfs:label "is ultimately consolidated by" ;
    rdfs:range cmns-org:LegalEntity ;
    rdfs:subPropertyOf fibo-be-le-lei:isConsolidatedBy ;
    skos:definition "indicates that the entity considered the 'end node' or consolidating entity (parent) fully consolidates the accounting of the 'start node' (child) per the accounting rules specified, and is the most distant consolidating entity to that child in any applicable ownership hierarchy" ;
    cmns-av:adaptedFrom "GLEIF Level 2 Relationship Record (RR) Common Data Format (CDF), see https://www.gleif.org/en/about-lei/common-data-file-format/relationship-record-cdf-format#" .

fibo-be-le-lp:BusinessLicense a owl:Class ;
    rdfs:label "business license" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-le-lp:BusinessEntity ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rga:isRecognizedIn ;
            owl:someValuesFrom cmns-rga:Jurisdiction ],
        fibo-fnd-law-lcap:License ;
    skos:definition "license that allows the holder to conduct business or carry out a specific profession within some jurisdiction for some period of time" .

fibo-be-le-lp:CharteredLegalPerson a owl:Class ;
    rdfs:label "chartered legal person" ;
    rdfs:subClassOf cmns-org:LegalEntity ;
    skos:definition "a legal person created by a royal charter or decree" ;
    skos:example "Anything with 'Royal Institute' in the name. Also universities are generally set up by royal charter in a monarchy or principality, (often pre-dating any Privy Council i.e. directly be the monarch in the case of older universities). The Bank of England and the British Broadcasting Council (BBC) are also incorporated through Royal Charter." ;
    cmns-av:explanatoryNote "In a monarchy or principality, the monarch typically vests the power to create such bodies, in an entity called (for example) the Privy Council." .

fibo-be-le-lp:PowerOfAttorney a owl:Class ;
    rdfs:label "power of attorney" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-law-lcap:isConferredOn ;
            owl:someValuesFrom fibo-be-le-lp:LegallyCompetentNaturalPerson ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-dt:Date ;
            owl:onProperty fibo-fnd-agr-ctr:hasEffectiveDate ],
        fibo-fnd-law-lcap:LegalCapacity ;
    skos:definition "legal authorization given by one party (the principal) to another (the agent or attorney-in-fact) to perform certain acts on the principal's behalf" ;
    cmns-av:explanatoryNote "The appointment can be effective immediately or if the principal is unable to make decisions or perform certain actions on their own. It may be a (1) general power of attorney that authorizes the agent to act generally on behalf of the principal, such as to transfer funds from one account to another, pay debts, make investments, and so forth, or (2) limited to a specific act or situation, such as for management of an individual's finances in a single account, such as a brokerage account, or for management of healthcare. Decisions made and actions taken by an attorney in fact (within the scope of his or her authority) are legally binding on the principal." .

fibo-be-le-lp:SpecialPurposeVehicle a owl:Class ;
    rdfs:label "special purpose vehicle"@en-US,
        "fonds commun de placement"@fr-FR ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-dt:Date ;
            owl:onProperty fibo-be-le-lp:hasIntendedLiquidationDate ],
        cmns-org:LegalEntity ;
    skos:definition "legal entity created to fulfill narrow, specific, and frequently temporary objectives"@en ;
    cmns-av:abbreviation "SPE"@en,
        "SPV"@en ;
    cmns-av:explanatoryNote "A special purpose vehicle (SPV), also known as a special purpose entity (SPE), refers to a legal entity, typically a limited company or partnership, created to isolate a parent company from financial risk, including bankruptcy."@en ;
    cmns-av:synonym "special purpose entity"@en .

fibo-be-le-lp:StatutoryBody a owl:Class ;
    rdfs:label "statutory body" ;
    rdfs:subClassOf cmns-org:LegalEntity ;
    skos:definition "legal entity established by a government to consider evidence and make judgements in some field of activity" .

fibo-be-le-lp:VariableInterestEntity a owl:Class ;
    rdfs:label "variable interest entity"@en ;
    rdfs:subClassOf cmns-org:LegalEntity ;
    skos:definition "legal entity whose shareholders are entitled to a percentage of a named company's profits via a private contract"@en ;
    cmns-av:abbreviation "VIE"@en ;
    cmns-av:explanatoryNote "Variable interest entity (VIE) is a term used by the Financial Accounting Standards Board (FASB) to refer to a legal entity with certain characteristics such that a public company with a financial interest in the entity is subject to certain financial reporting requirements. Examples include certain Chinese companies, such as Alibaba, that leverage VIEs to gain access to foreign capital that would otherwise not be available due to Chinese government regulations."@en ;
    cmns-av:synonym "shell company"@en .

fibo-be-mod: a owl:Ontology ;
    rdfs:label "Metadata about the FIBO Business Entities (BE) Domain" ;
    dcterms:abstract """This ontology provides metadata about the FIBO Business Entities (BE) Domain, which defines business concepts for data governance, interoperability, and in regulatory reporting about business entities.

The scope of the BE domain includes business and legal entity concepts that are considered by financial industry firms, regulators and other industry participants relevant to financial services and more broadly, including:
 - Legal entities generally
 - Corporate structure, ownership and control, including primary executive roles for businesses,
 - Functional entities such as governments and government entities, non-governmental organizations, international organizations, not-for-profit organizations, etc.
 - Concepts specific to corporations, partnerships, private limited companies, sole proprietorships, and trusts.""" ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license """Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2018-2026 Object Management Group

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2026-04-15T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-be-fct-mod:,
        fibo-be-ge-mod:,
        fibo-be-le-mod:,
        fibo-be-oac-mod:,
        fibo-be-ptr-mod:,
        fibo-be-plc-mod:,
        fibo-be-sps-mod:,
        fibo-be-tr-mod:,
        fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20260401/MetadataBE/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/BE/20180801/BE/MetadataBE.rdf version of this ontology was modified to eliminate informative Functional Entities ontologies, merging their content into others as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20190401/MetadataBE.rdf version of the ontology and subordinate module-specific BE metadata ontologies were modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230301/MetadataBE.rdf version of the ontology was modified to merge details from the old corporations ontology into corporate bodies for consistency and useability (BE-259).",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20251001/MetadataBE.rdf version of the ontology was modified to update metadata including providing an expanded domain name for usability in business glossaries (FND-404)." ;
    cmns-av:copyright "Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc.",
        "Copyright (c) 2018-2026 Object Management Group" .

fibo-be-mod:BEDomain a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "business entities (BE) domain" ;
    dcterms:abstract """The FIBO Business Entities (BE) Domain covers defines business concepts that are used for data governance, interoperability, and in regulatory reporting about business entities.

The scope of the BE domain includes business and legal entity concepts that are considered by financial industry firms, regulators and other industry participants relevant to financial services and more broadly, including:
 - Legal entities generally
 - Corporate structure, ownership and control, including primary executive roles for businesses,
 - Functional entities such as governments and government entities, non-governmental organizations, international organizations, not-for-profit organization, etc.
 - Concepts specific to corporations, partnerships, private limited companies, sole proprietorships, and trusts.""" ;
    dcterms:contributor "Adaptive Analytics, Inc.",
        "Bloomberg LP",
        "Citigroup",
        "Credit Suisse",
        "Deutsche Bank",
        "Exprentis",
        "Federated Knowledge, LLC",
        "Hypercube Ltd.",
        "Intuitive Technology Partners, Inc.",
        "John F. Gemski",
        "Nordea Bank AB",
        "Office of Financial Research (US Dept of the Treasury)",
        "Pinnacle Bank (Morgan Hill, California)",
        "State Street Bank and Trust",
        "Statistics Canada",
        "Tahoe Blue Ltd",
        "Thematix Partners, LLC",
        "Wells Fargo",
        "Working Ontologist",
        "agnos.ai UK Ltd." ;
    dcterms:creator "https://wiki.edmcouncil.org/display/BE/FIBO+-+FCT+-+Business+Entities+Home"^^xsd:anyURI ;
    dcterms:hasPart fibo-be-fct-mod:FunctionalEntitiesModule,
        fibo-be-ge-mod:GovernmentEntitiesModule,
        fibo-be-le-mod:LegalEntitiesModule,
        fibo-be-oac-mod:OwnershipAndControlModule,
        fibo-be-ptr-mod:PartnershipsModule,
        fibo-be-plc-mod:PrivateLimitedCompaniesModule,
        fibo-be-sps-mod:SoleProprietorshipsModule,
        fibo-be-tr-mod:TrustsModule ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license """Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc.
Copyright (c) 2018-2026 Object Management Group

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2026-04-15T18:00:00"^^xsd:dateTime ;
    dcterms:title "EDMC Financial Industry Business Ontology (FIBO) Business Entities (BE) Domain",
        "FIBO BE Domain" ;
    rdfs:seeAlso "https://spec.edmcouncil.org/fibo/"^^xsd:anyURI ;
    skos:altLabel "Business Entities (BE)" ;
    cmns-av:copyright "Copyright (c) 2018-2026 EDM Association dba EDM Council, Inc.",
        "Copyright (c) 2018-2026 Object Management Group" .

fibo-be-oac-cpty:ContractualControl a owl:Class ;
    rdfs:label "contractual control" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-rel-rel:isConferredBy ;
            owl:someValuesFrom fibo-fnd-agr-ctr:Contract ],
        fibo-fnd-oac-ctl:DeJureControl ;
    skos:definition "control established through the terms of some contract" .

fibo-be-oac-cpty:JointControllingParty a owl:Class ;
    rdfs:label "joint controlling party" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-be-oac-cpty:ControllingAlliance ;
            owl:onProperty cmns-rlcmp:isPlayedBy ],
        fibo-be-oac-cpty:EntityControllingParty ;
    owl:disjointWith fibo-be-oac-cpty:SoleControllingParty ;
    skos:definition "party that collectively has the authority to control the affairs of some business organization" .

fibo-be-oac-cpty:Receiver a owl:Class ;
    rdfs:label "receiver" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:isControllingPartyIn ;
            owl:someValuesFrom fibo-be-oac-cpty:CourtAppointedControl ],
        fibo-be-oac-cpty:DeJureControllingInterestParty ;
    skos:definition "party appointed by some court for the purposes of winding up the affairs of some entity which is no longer solvent" .

fibo-be-oac-cpty:advises a owl:ObjectProperty ;
    rdfs:label "advises" ;
    rdfs:domain fibo-fnd-oac-ctl:ControllingParty ;
    rdfs:range fibo-be-oac-cpty:ControlledParty ;
    rdfs:subPropertyOf fibo-fnd-oac-ctl:isPartyControlling ;
    owl:inverseOf fibo-be-oac-cpty:isAdvisedBy ;
    skos:definition "provides counsel or guidance to" .

fibo-be-oac-cpty:isBasedOnInvestmentEquity a owl:ObjectProperty ;
    rdfs:label "is based on investment equity" ;
    rdfs:domain fibo-be-oac-cpty:InvestmentBasedDeFactoControl ;
    rdfs:range fibo-be-oac-opty:InvestmentEquity ;
    rdfs:subPropertyOf fibo-fnd-rel-rel:isConferredBy ;
    skos:definition "indicates investment-based de facto control, which is is based on the holding of some investment equity by some party" .

fibo-be-oac-cctl:Affiliation a owl:Class ;
    rdfs:label "affiliation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-pts:hasActor ;
            owl:someValuesFrom fibo-be-oac-cctl:ControllingAffiliate ],
        [ a owl:Restriction ;
            owl:onProperty cmns-pts:hasUndergoer ;
            owl:someValuesFrom fibo-be-oac-cctl:ControlledAffiliate ],
        fibo-fnd-oac-ctl:Control ;
    skos:definition "situation in which a controlled party is affiliated with a controlling party for some period of time" .

fibo-be-oac-cctl:JointVenturePartner a owl:Class ;
    rdfs:label "joint venture partner" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:isControllingPartyOf ;
            owl:someValuesFrom fibo-be-le-fbo:JointVenture ],
        fibo-be-oac-cpty:EntityControllingParty ;
    skos:definition "party that shares capital, technology, human resources, risks, and benefits of an entity under shared control" .

fibo-be-oac-cctl:hasAffiliate a owl:ObjectProperty ;
    rdfs:label "has affiliate" ;
    rdfs:domain cmns-org:LegalEntity ;
    rdfs:range fibo-be-oac-cctl:Affiliate ;
    rdfs:subPropertyOf fibo-fnd-oac-ctl:isControlledPartyOf ;
    skos:definition "has a party which directly, or indirectly through one or more intermediaries, controls, or is controlled by, or is under common control with the company" .

fibo-be-oac-cctl:hasDomesticUltimateParent a owl:ObjectProperty ;
    rdfs:label "has domestic ultimate parent" ;
    rdfs:range fibo-be-oac-cctl:DomesticUltimateParent ;
    rdfs:subPropertyOf fibo-be-oac-cpty:hasMajorityControllingParty ;
    skos:definition "relates an organization to another recognized as its ultimate parent, within its country or jurisdiction of incorporation, if it has one" ;
    skos:editorialNote "In the case of companies that are subsidiaries of another company that itself has a parent, this identifies the organization at the top of the hierarchy of organizations in the country of registration. Adapted from consensus definition of Ultimate Parent, now that this is split into national and global parent." ;
    cmns-av:adaptedFrom "consensus definition of ultimate parent, with the split between domestic and global parent" .

fibo-be-oac-cctl:hasGlobalUltimateParent a owl:ObjectProperty ;
    rdfs:label "has global ultimate parent" ;
    rdfs:range fibo-be-oac-cctl:GlobalUltimateParent ;
    rdfs:subPropertyOf fibo-be-oac-cpty:hasMajorityControllingParty ;
    skos:definition "relates an organization to another recognized as its ultimate parent, if it has one" ;
    skos:editorialNote "In the case of companies that are subsidiaries of another company that itself has a parent, this identifies the organization at the top of the hierarchy, world-wide. Adapted from consensus definition of Ultimate Parent, now that this is split into national and global parent." ;
    cmns-av:adaptedFrom "consensus definition of ultimate parent, with the split between domestic and global parent" .

fibo-be-oac-cctl:hasSubsidiary a owl:ObjectProperty ;
    rdfs:label "has subsidiary" ;
    rdfs:domain cmns-org:LegalEntity ;
    rdfs:range fibo-be-oac-cctl:Subsidiary ;
    owl:propertyChainAxiom ( cmns-rlcmp:playsRole fibo-be-oac-cctl:isParentCompanyOf ) ;
    skos:definition "relates a legal entity to another organization that it owns at least 50 percent of" .

fibo-be-oac-cctl:isWhollyOwnedBy a owl:ObjectProperty ;
    rdfs:label "is wholly owned by" ;
    rdfs:domain cmns-org:LegalEntity ;
    rdfs:range fibo-be-oac-cctl:TotalControllingInterestParty ;
    owl:propertyChainAxiom ( cmns-rlcmp:playsRole fibo-be-oac-cctl:isSubsidiaryOf ) ;
    skos:definition "relates a legal entity to a party that has 100 percent ownership and control over it" .

fibo-be-oac-cown:BeneficialOwnership a owl:Class ;
    rdfs:label "beneficial ownership" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-own:hasOwnedAsset ;
            owl:someValuesFrom fibo-fnd-oac-own:Asset ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-own:hasOwningParty ;
            owl:someValuesFrom fibo-be-oac-cown:BeneficialOwner ],
        [ a owl:Restriction ;
            owl:onProperty cmns-ra:isRegisteredBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( cmns-ra:RegistrationAuthority cmns-ra:Registrar ) ] ],
        fibo-fnd-oac-own:Ownership ;
    skos:definition "situation linking party that enjoys the benefits of ownership (such as receipt of income) of something even though its ownership (title) may be in the name of another party (called a nominee or registered owner) to the asset that they own" ;
    cmns-av:explanatoryNote "Beneficial ownership may be shared among a group of individuals. If a beneficial owner acquires a position of more than 5 percent in the United States, it must file Schedule 13D or 13G under Section 12 of the Securities Exchange Act of 1934." .

fibo-be-oac-cown:PurchaseLot a owl:Class ;
    rdfs:label "purchase lot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-be-oac-cown:consistsOfNumberOfUnits ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-oac-own:FinancialAsset ;
    skos:definition "financial asset that is a block of securities or other financial assets bought in one transaction on a given date at a specific price" ;
    skos:example "Buying 100 shares of Apple on Jan 10 at $150/share is one purchase lot; buying 50 more shares on Mar 15 at $160/share is another purchase lot." ;
    cmns-av:explanatoryNote "Purchase lot is typically used as a trading term by brokers and portfolio managers to describe how holdings are grouped." .

fibo-be-oac-cown:Shareholding a owl:Class ;
    rdfs:label "shareholding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-be-oac-cown:consistsOfNumberOfUnits ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-oac-own:FinancialAsset ;
    skos:definition "ownership interest in the equity of a company, represented by shares that confer financial rights and governance privileges" ;
    cmns-av:explanatoryNote "Shareholding refers to the total ownership a party has in some organization, and determines voting power, dividend entitlement, and exposure to risk." .

fibo-be-oac-cown:TaxLot a owl:Class ;
    rdfs:label "tax lot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty fibo-be-oac-cown:consistsOfNumberOfUnits ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        fibo-fnd-oac-own:FinancialAsset ;
    skos:definition "financial asset that is a block of securities or other financial assets with a distinct cost basis for tax reporting purposes" ;
    cmns-av:explanatoryNote """Tax lots reflect how shares or other assets are tracked for capital gains and may be adjusted by events including:
- reinvested dividends (creates very small, new tax lots);
- stock splits or mergers (adjusts basis, may create fractional lots);
- Wash sale rules (can change which lots are recognized).
When an investor sells, they select which tax lot to sell (specific ID, FIFO, etc.), which determines realized gain or loss.""" .

fibo-be-oac-exec:ArticlesOfIncorporation a owl:Class ;
    rdfs:label "articles of incorporation" ;
    rdfs:subClassOf fibo-be-le-cb:InstrumentOfIncorporation ;
    skos:definition "contract that establishes a new corporation or, when amended, adjusts the legal basis for the corporation, and outlines basic information about the corporation, including the type of business, and a description of the business' operational characteristics" ;
    cmns-av:synonym "articles of association" .

fibo-be-oac-exec:Authorization a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass cmns-bauth:Authorization .

fibo-be-oac-exec:AuthorizedParty a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass cmns-bauth:AuthorizedParty .

fibo-be-oac-exec:AuthorizingParty a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass cmns-bauth:AuthorizingParty .

fibo-be-oac-exec:BoardCompositionControl a owl:Class ;
    rdfs:label "board composition control" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:involvesControlledThing ;
            owl:someValuesFrom fibo-be-oac-exec:BoardMember ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( fibo-be-oac-cctl:SignificantShareholder fibo-be-oac-opty:EntityOwner ) ] ;
            owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ],
        fibo-fnd-oac-ctl:Control ;
    skos:definition "situation in which a voting shareholder, entity owner, or some other party in the case of a not-for-profit organization, appoints and/or nominates someone to the board of directors of an organization for some period of time" .

fibo-be-oac-exec:BoardMembership a owl:Class ;
    rdfs:label "board membership" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:involvesControlledThing ;
            owl:someValuesFrom fibo-be-oac-cpty:ControlledParty ],
        [ a owl:Restriction ;
            owl:onProperty fibo-fnd-oac-ctl:hasPartyInControl ;
            owl:someValuesFrom fibo-be-oac-exec:BoardMember ],
        fibo-fnd-oac-ctl:Control ;
    skos:definition "situation relating an individual member of the board of directors to the organization" .

fibo-be-oac-exec:ChiefExecutiveOfficer a owl:Class ;
    rdfs:label "chief executive officer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-org:manages ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( cmns-org:LegalEntity cmns-org:FormalOrganization ) ] ],
        fibo-be-oac-exec:CorporateOfficer,
        fibo-be-oac-exec:ExecutiveBoardMember,
        fibo-be-oac-exec:PrincipalParty ;
    skos:definition "top corporate officer responsible for an organization's overall operations and performance" ;
    cmns-av:abbreviation "CEO" ;
    cmns-av:explanatoryNote "He or she is the leader of the firm, serves as the main link between the board of directors (the board) and the firm's various parts or levels, and is held solely responsible for the firm's success or failure. One of the major duties of a CEO is to maintain and implement corporate policy, as established by the board. Also called President or managing director, he or she may also be the chairman (or chairperson) of the board." .

fibo-be-oac-exec:ChiefFinancialOfficer a owl:Class ;
    rdfs:label "chief financial officer" ;
    rdfs:subClassOf fibo-be-oac-exec:CorporateOfficer ;
    skos:definition "senior-most corporate officer responsible for financial control and planning for an organization or project" ;
    cmns-av:abbreviation "CFO" ;
    cmns-av:explanatoryNote "He or she is in charge of all accounting functions including (1) credit control, (2) preparing budgets and financial statements, (3) coordinating financing and fund raising, (4) monitoring expenditure and liquidity, (5) managing investment and taxation issues, (6) reporting financial performance to the board, and (7) providing timely financial data to the CEO. Also called chief finance officer, comptroller, controller, or finance controller." .

fibo-be-oac-exec:CompanySecretary a owl:Class ;
    rdfs:label "company secretary" ;
    rdfs:subClassOf fibo-be-oac-exec:CorporateOfficer ;
    skos:definition "corporate officer appointed by the directors of an organization, responsible for ensuring compliance with legal obligations related to corporate governance" ;
    cmns-av:explanatoryNote "His or her formal duties include (1) calling meetings, (2) recording minutes of the meetings, (3) keeping statutory record books, (4) proper payment of dividend and interest payments, and (5) proper drafting and execution of agreements, contracts, and resolutions." ;
    cmns-av:synonym "corporate secretary" .

fibo-be-oac-exec:CorporateBylaws a owl:Class ;
    rdfs:label "corporate bylaws" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-be-le-cb:hasSharesAuthorized ;
            owl:someValuesFrom xsd:nonNegativeInteger ],
        fibo-be-oac-exec:Bylaws ;
    skos:definition "written rules for conduct of a corporation, adopted by the board of directors" ;
    cmns-av:explanatoryNote "Corporate bylaws may contain any provision, not inconsistent with law or with the certificate of incorporation, relating to the business of the corporation, the conduct of its affairs, and its rights or powers or the rights or powers of its stockholders, directors, officers or employees. Changes to the bylaws of a corporation require a board-level resolution and may require a vote of the shareholders." .

fibo-be-oac-exec:InternalAuditor a owl:Class ;
    rdfs:label "internal auditor" ;
    rdfs:subClassOf fibo-be-oac-exec:Auditor,
        fibo-fnd-org-fm:Employee ;
    owl:disjointWith fibo-be-oac-exec:ExternalAuditor ;
    skos:definition "employee who is qualified and authorized to review and verify the accuracy of financial records and evaluate internal controls and compliance" .

fibo-be-oac-exec:LegallyDelegatedAuthority a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass cmns-bauth:LegallyDelegatedAuthority .

fibo-be-oac-exec:NonExecutiveBoardMember a owl:Class ;
    rdfs:label "non-executive board member" ;
    rdfs:subClassOf fibo-be-oac-exec:BoardMember ;
    owl:disjointWith fibo-be-oac-exec:ExecutiveBoardMember ;
    skos:definition "member of the board of directors of an organization that has no executive responsibilities towards the running of that organization" ;
    cmns-av:synonym "outside director" .

fibo-be-oac-exec:authorizes a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:authorizes .

fibo-be-oac-exec:authorizesThrough a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:authorizesThrough .

fibo-be-oac-exec:delegatesControlTo a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:delegatesControlTo .

fibo-be-oac-exec:hasAuthorizedParty a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:hasAuthorizedParty .

fibo-be-oac-exec:hasAuthorizingParty a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:hasAuthorizingParty .

fibo-be-oac-exec:hasDelegatedControlOf a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:hasDelegatedControlOf .

fibo-be-oac-exec:hasPrincipalManagingParty a owl:ObjectProperty ;
    rdfs:label "has principal managing party" ;
    rdfs:domain fibo-be-oac-cpty:ControlledParty ;
    rdfs:range fibo-be-oac-exec:PrincipalParty ;
    rdfs:subPropertyOf fibo-be-oac-cpty:hasControllingOrganizationMember ;
    owl:inverseOf fibo-be-oac-exec:isPrincipalPartyOf ;
    skos:definition "indicates a controlling party that is responsible for the management of daily business operations" .

fibo-be-oac-exec:hasResponsibleParty a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:hasResponsibleParty .

fibo-be-oac-exec:hasSigningAuthorityFor a owl:ObjectProperty ;
    rdfs:label "has signing authority for" ;
    rdfs:domain fibo-be-oac-exec:Signatory ;
    rdfs:subPropertyOf cmns-bauth:isAuthorizedBy ;
    owl:inverseOf fibo-be-oac-exec:designatesSignatory ;
    skos:definition "indicates the party for which a signatory has the ability to sign agreements, access accounts and perform related tasks" .

fibo-be-oac-exec:hasVestedInIt a owl:ObjectProperty ;
    rdfs:label "has vested in it" ;
    rdfs:domain cmns-bauth:LegallyDelegatedAuthority ;
    rdfs:range fibo-fnd-law-lcap:DelegatedLegalAuthority ;
    rdfs:subPropertyOf fibo-fnd-law-lcap:hasCapacity ;
    skos:definition "indicates the delegated legal authority that is vested in the controlling party" .

fibo-be-oac-exec:isAuthorizedBy a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:isAuthorizedBy .

fibo-be-oac-exec:isAuthorizedThrough a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty cmns-bauth:isAuthorizedThrough .

fibo-be-oac-exec:isDirectorOf a owl:ObjectProperty ;
    rdfs:label "is director of" ;
    rdfs:domain fibo-be-oac-exec:BoardMember ;
    rdfs:range fibo-be-oac-cpty:ControlledParty ;
    rdfs:subPropertyOf fibo-fnd-oac-ctl:isPartyControlling ;
    owl:inverseOf fibo-be-oac-exec:hasDirector ;
    skos:definition "indicates the organization that the board member oversees" .

fibo-be-oac-exec:isOfficerOf a owl:ObjectProperty ;
    rdfs:label "is officer of" ;
    rdfs:domain fibo-be-oac-exec:CorporateOfficer ;
    rdfs:range fibo-be-oac-cpty:ControlledParty ;
    rdfs:subPropertyOf fibo-fnd-oac-ctl:isPartyControlling ;
    owl:inverseOf fibo-be-oac-exec:hasCorporateOfficer ;
    skos:definition "indicates the organization that the person has some authority over and managerial responsibility for" .

fibo-be-oac-opty:ControllingEquity a owl:Class ;
    rdfs:label "controlling equity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fibo-fnd-oac-ctl:DeJureControl ;
            owl:onProperty fibo-fnd-rel-rel:confers ],
        fibo-fnd-oac-own:ShareholdersEquity ;
    skos:definition "shareholders's equity that formally confers control in the entity, either by law or as explicitly stated in a corresponding equity instrument" .

fibo-be-oac-opty:DirectConsolidation a owl:Class ;
    rdfs:label "direct consolidation" ;
    rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
    skos:definition "direct ownership of an entity recorded as accounting consolidation" .

fibo-be-oac-opty:ForeignBranchOwnership a owl:Class ;
    rdfs:label "foreign branch ownership" ;
    rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
    skos:definition "ownership by some party of some formal organization or organizational sub-unit that is a foreign affiliate and legally part of the owning entity" .

fibo-be-oac-opty:InvestorContract a owl:Class ;
    rdfs:label "investor contract" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-fnd-agr-ctr:definesTermsFor ;
            owl:someValuesFrom fibo-be-oac-opty:InvestmentEquity ],
        fibo-fnd-agr-ctr:WrittenContract ;
    skos:definition "Contract setting out the terms under which some investor invests in the entity and setting out the rights which are conferred on that investor." .

fibo-be-oac-opty:UltimateConsolidation a owl:Class ;
    rdfs:label "ultimate ownership" ;
    rdfs:subClassOf fibo-be-oac-opty:EntityOwnership ;
    skos:definition "highest-level (top, end) ancestral ownership, evidenced by accounting consolidation, by some party of some other legal entity" .

fibo-be-oac-opty:guarantees a owl:ObjectProperty ;
    rdfs:label "guarantees" ;
    skos:definition "provides a formal assurance or promise, esp. that certain conditions shall be fulfilled relating to a product, service, or transaction" .

fibo-be-oac-opty:hasDirectOwningEntity a owl:ObjectProperty ;
    rdfs:label "has direct owning entity" ;
    owl:propertyChainAxiom ( fibo-be-oac-opty:hasDirectOwnership fibo-be-oac-opty:hasOwningEntity ) ;
    skos:definition "relates a formal organization to a direct legal person / owner" .

fibo-be-ptr-ptr:GeneralPartnership a owl:Class ;
    rdfs:label "general partnership" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-be-ptr-ptr:hasGeneralPartner ;
            owl:someValuesFrom fibo-be-ptr-ptr:GeneralPartner ],
        [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                    owl:onClass fibo-be-ptr-ptr:GeneralPartner ;
                    owl:onProperty cmns-rlcmp:playsRole ] ],
        fibo-be-ptr-ptr:Partnership ;
    skos:definition "partnership that has at least two general partners that agree to share in all assets, profits, and financial and legal liabilities of the business" ;
    cmns-av:abbreviation "GP" ;
    cmns-av:explanatoryNote "General partnerships are the most basic and common form of partnership world-wide." .

fibo-be-ptr-ptr:LimitedLiabilityLimitedPartnership a owl:Class ;
    rdfs:label "limited liability limited partnership" ;
    rdfs:subClassOf fibo-be-ptr-ptr:LimitedPartnership ;
    skos:definition "limited partnership that consists of one or more general partners who are liable for the obligations of the entity as well as one or more protected limited liability partners" ;
    cmns-av:abbreviation "LLLP" ;
    cmns-av:explanatoryNote "The primary difference between an LLLP and more traditional limited partnership is that an LLLP allows liability transfer from the general partner's (to external insurer) for debts and obligations of the limited partnership. Typically, general partners manage the LLLP, while the limited partners' interest is primarily for investment purposes." .

fibo-be-ptr-ptr:LimitedLiabilityPartnership a owl:Class ;
    rdfs:label "limited liability partnership" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fibo-be-ptr-ptr:hasGeneralPartner ;
            owl:someValuesFrom fibo-be-ptr-ptr:GeneralPartner ],
        fibo-be-ptr-ptr:Partnership ;
    owl:disjointWith fibo-be-ptr-ptr:LimitedPartnership ;
    skos:definition "partnership that has general partners but provides its individual partners some level of protection against personal liability for certain partnership liabilities" ;
    skos:example "Law firms, accountancies, wealth managers, professional medical groups, and other professional consultancies often take the form of a limited liability partnership.",
        "One example of a limited liability partnership is that of an incorporated limited partnership (ILP) in Australia." ;
    cmns-av:abbreviation "LLP" ;
    cmns-av:explanatoryNote "LLPs are a flexible legal and tax entity that allows partners to benefit from economies of scale by working together while also reducing their liability for the actions of other partners." .

fibo-be-ptr-ptr:isGeneralPartnerOf a owl:ObjectProperty ;
    rdfs:label "is general partner of" ;
    rdfs:domain fibo-be-ptr-ptr:GeneralPartner ;
    rdfs:range fibo-be-ptr-ptr:Partnership ;
    rdfs:subPropertyOf cmns-pts:actsOn ;
    owl:inverseOf fibo-be-ptr-ptr:hasGeneralPartner ;
    skos:definition "indicates the organization that the general partner manages" .

fibo-be-ptr-ptr:isLimitedPartnerOf a owl:ObjectProperty ;
    rdfs:label "is limited partner of" ;
    rdfs:domain fibo-be-ptr-ptr:LimitedPartner ;
    rdfs:range fibo-be-ptr-ptr:Partnership ;
    rdfs:subPropertyOf cmns-pts:actsOn ;
    owl:inverseOf fibo-be-ptr-ptr:hasLimitedPartner ;
    skos:definition "indicates the organization that the limited partner participates in" .

fibo-be-plc-plc:LimitedLiabilityCompanyTaxedAsACorporation a owl:Class ;
    rdfs:label "limited liability company taxed as a corporation" ;
    rdfs:subClassOf fibo-be-plc-plc:LimitedLiabilityCompany ;
    skos:definition "limited liability company that has elected to have corporate tax status" ;
    cmns-av:abbreviation "C-LLC" ;
    cmns-av:explanatoryNote "In the United States, LLCs that elect to be taxed as a corporation do so by filing an IRS Form 8832." .

fibo-be-plc-plc:ManagerManagedLimitedLiabilityCompany a owl:Class ;
    rdfs:label "manager-managed limited liability company" ;
    rdfs:subClassOf fibo-be-plc-plc:LimitedLiabilityCompany ;
    skos:definition "limited liability company in which the members appoint one or more managers to handle the daily operations and administrative responsibilities of the organization" ;
    cmns-av:explanatoryNote "If no members are interested in managing the LLC, an external manager (someone who doesn't own any portion of the LLC) can be hired to run the business operations, including, in some jurisdictions, a third-party entity, such as another company." .

fibo-be-plc-plc:PrivateLimitedCompany a owl:Class ;
    rdfs:label "private limited company" ;
    rdfs:subClassOf fibo-be-plc-plc:PrivateCompanyWithLimitedLiability ;
    skos:definition "private limited company whose shareholders' liability is limited to the capital they originally invested" ;
    cmns-av:abbreviation "Ltd." ;
    cmns-av:explanatoryNote "Private limited companies are common in countries including the U.K., Ireland, and Canada. They have one or more members, also called shareholders or owners, who buy in through private sales. Directors are company employees who keep up with all administrative tasks and tax filings but do not need to be shareholders." .

fibo-be-sps-sps:SoleProprietor a owl:Class ;
    rdfs:label "sole proprietor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-le-lp:LegallyCompetentNaturalPerson ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty fibo-be-oac-opty:hasInvestmentEntity ;
            owl:someValuesFrom fibo-be-sps-sps:SoleProprietorship ],
        [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty fibo-fnd-oac-oac:ownsAndControls ;
                    owl:someValuesFrom fibo-be-sps-sps:SoleProprietorship ] ],
        fibo-be-oac-opty:EntityOwner ;
    skos:definition "party that owns a business, has the rights to all profits from that business and is considered a single entity (unincorporated) together with that business for tax and liability purposes" ;
    cmns-av:explanatoryNote "A sole proprietor has unlimited liability with respect to any business debts." ;
    cmns-av:synonym "sole owner",
        "sole trader" .

fibo-be-tr-tr:LivingTrust a owl:Class ;
    rdfs:label "living trust" ;
    rdfs:subClassOf fibo-be-tr-tr:Trust ;
    skos:definition "trust created during an individual's lifetime where a designated person, the trustee, is given responsibility for managing that individual's assets for the benefit of the eventual beneficiary" ;
    cmns-av:explanatoryNote "A living trust is designed to allow for the easy transfer of the trust creator or settlor's assets while bypassing the often complex and expensive legal process of probate. Living trust agreements designate a trustee who holds legal possession of assets and property that flow into the trust." .

fibo-be-tr-tr:RevocableTrust a owl:Class ;
    rdfs:label "revocable trust" ;
    rdfs:subClassOf fibo-be-tr-tr:Trust ;
    owl:disjointWith fibo-be-tr-tr:IrrevocableTrust ;
    skos:definition "trust in which legal ownership of the trust property is transferred to the trustee, but the trustor retains full power to revoke, modify or amend the trust" .

fibo-be-tr-tr:TestamentaryTrust a owl:Class ;
    rdfs:label "testamentary trust" ;
    rdfs:subClassOf fibo-be-tr-tr:IrrevocableTrust ;
    skos:definition "trust established in accordance with the instructions contained in a last will and testament" ;
    cmns-av:explanatoryNote "A will could have more than one testamentary trust. The trustee named is responsible for managing and distributing the trustor's assets to the beneficiaries as directed in the will. Sometimes called a will trust, the testamentary trust is irrevocable." .

fibo-be-tr-tr:TrustFundManager a owl:Class ;
    rdfs:label "trust fund manager" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom fibo-be-tr-tr:Trust ;
                    owl:onProperty cmns-org:manages ] ],
        cmns-bauth:LegallyDelegatedAuthority ;
    skos:definition "party empowered to act on behalf of the trustee to manage the assets of the trust" .

fibo-be-tr-tr:hasTrustee a owl:ObjectProperty ;
    rdfs:label "has trustee" ;
    rdfs:domain fibo-be-tr-tr:Trust ;
    rdfs:range fibo-be-tr-tr:Trustee ;
    rdfs:subPropertyOf cmns-pts:isAffectedBy ;
    owl:inverseOf fibo-be-tr-tr:isTrusteeOf ;
    skos:definition "links a trust to a named trustee" .

fibo-fnd-aap-ppl:IdentityDocument a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-ge-ge:Government ;
            owl:onProperty fibo-fnd-rel-rel:isIssuedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

cmns-org:OrganizationName a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange cmns-txt:Text ;
            owl:onProperty fibo-be-le-lei:hasTransliteratedName ] .

cmns-org:ServiceProvider a owl:Class ;
    rdfs:subClassOf fibo-be-fct-fct:FunctionalEntity .

fibo-be-corp-corp: a owl:Ontology ;
    rdfs:label "Corporations Ontology" ;
    dcterms:abstract "This ontology originally defined the fundamental concepts for companies incorporated by the issuance of shares. Terms defined in this ontology are those which are applicable to all such entities. Many of these concepts form the basis of the relationships of ownership and control which obtain between entities of this type." ;
    dcterms:license """Copyright (c) 2013-2025 EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    owl:imports fibo-be-le-cb:,
        fibo-be-le-fbo:,
        fibo-be-le-lp:,
        fibo-fnd-acc-cur:,
        fibo-fnd-gao-obj:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-dt:,
        cmns-dsg:,
        cmns-id:,
        cmns-org:,
        cmns-rga: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20251001/Corporations/Corporations/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/BE/20131101/Corporations/Corporations.rdf version of this ontology was modified per the issue resolutions identified in the FIBO BE 1.0 FTF report.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20160201/Corporations/Corporations.rdf version of this ontology was modified per the FIBO 2.0 RFC.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20180901/Corporations/Corporations.rdf version of this ontology was modified per the FIBO 2.0 RFC to generalize certain unions where they were no longer required.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20190101/Corporations/Corporations.rdf version of this ontology was modified to reflect moving hasObjective to FND.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20190401/Corporations/Corporations.rdf version of this ontology was modified to replace hasDefinition with isDefinedIn to clarify intent.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20190701/Corporations/Corporations.rdf version of this ontology was modified to eliminate deprecated elements.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20190901/Corporations/Corporations.rdf version of this ontology was modified to eliminate duplication of concepts in LCC.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20200201/Corporations/Corporations.rdf version of this ontology was modified to eliminate references to external dictionary sites that no longer resolve, eliminate circular and ambiguous definitions and make incorporation date and registration date explicit dates.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20210301/Corporations/Corporations.rdf version of this ontology was modified to reflect the move of some organization-specific concepts from BE to FND and to clean up typos.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20211201/Corporations/Corporations.rdf version of this ontology was modified to address text formatting hygiene issues and eliminate a dead link.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20220801/Corporations/Corporations.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary and revise definitions to be ISO 704 compliant as needed.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230101/Corporations/Corporations.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) and to eliminate redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230301/Corporations/Corporations.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20250301/Corporations/Corporations.rdf version of the ontology was modified to merge all constructs that were originally in this ontology with corporate bodies under legal entities for consistency and useability (BE-259)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2013-2025 EDM Council, Inc.",
        "Copyright (c) 2013-2025 Object Management Group, Inc." .

fibo-be-fct-fct:CooperativeSociety a owl:Class ;
    rdfs:label "cooperative society" ;
    rdfs:subClassOf fibo-be-fct-fct:FunctionalBusinessEntity ;
    skos:definition "organization owned by and operated for the benefit of those using its services" ;
    skos:example "In agriculture, there are broadly three types of cooperatives: a machinery pool, a manufacturing/marketing cooperative, and a credit union" ;
    cmns-av:synonym "cooperative" .

fibo-be-fct-fct:MerchantCategoryCodeScheme a owl:Class ;
    rdfs:label "merchant category code scheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-dsg:defines ;
            owl:someValuesFrom fibo-be-fct-fct:MerchantCategoryCode ],
        fibo-fnd-arr-cls:IndustrySectorClassificationScheme ;
    skos:definition "scheme defining a set of codes for classifying merchant services" ;
    cmns-av:adaptedFrom "ISO 18245:2003 Retail financial services - Merchant category codes" ;
    cmns-av:explanatoryNote "ISO 18245 provides a set of merchant category codes that are used internationally. Some countries, regional governments, banks, and other large organizations extend the basic codes with custom additions to fit business needs." .

fibo-be-fct-fct:MerchantIdentifier a owl:Class ;
    rdfs:label "merchant identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass fibo-be-fct-fct:Merchant ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        cmns-id:Identifier ;
    skos:definition "unique identifier for a merchant that is used, for example, for transaction interchange purposes" .

fibo-be-fct-fct:Syndicate a owl:Class ;
    rdfs:label "syndicate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom cmns-pts:Party ],
        cmns-org:Organization ;
    skos:definition "temporary, self-organizing group of people, companies, corporations or entities organized as an alliance whose purpose is to transact some specific business, or to pursue or promote a shared interest"@en ;
    skos:example "For example, when a group of investment banks work together to bring a new issue of securities to the market, they form a distributing syndicate. Other types of syndicates are created for underwriting, banking, and insurance."@en ;
    cmns-av:explanatoryNote "A syndicate is a temporary alliance formed by people or businesses to handle a large transaction that would be hard to execute individually. Syndication makes it easy for businesses to pool their resources and share risks."@en .

fibo-be-fct-fct:hasMerchantCategoryDescription a owl:DatatypeProperty ;
    rdfs:label "has merchant category description" ;
    rdfs:domain fibo-be-fct-fct:MerchantCategoryCode ;
    rdfs:range xsd:string ;
    skos:definition "provides a text description of the sector to which the code applies" .

fibo-be-fct-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Functional Entities Module" ;
    dcterms:abstract "The functional entities module includes ontologies describing entities that are defined according to their function, as opposed to their form, such as businesses, service providers, and publishers." ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-27T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/FunctionalEntities/MetadataBEFunctionalEntities/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-fct-mod:FunctionalEntitiesModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "functional entities module" ;
    dcterms:abstract "The functional entities module includes ontologies describing entities that are defined according to their function, as opposed to their form, such as businesses, service providers, and publishers." ;
    dcterms:hasPart fibo-be-fct-fct:,
        fibo-be-fct-pub: ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:title "FIBO BE Functional Entities Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Functional Entities Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-fct-pub:publishes a owl:ObjectProperty ;
    rdfs:label "publishes" ;
    rdfs:domain fibo-be-fct-pub:Publisher ;
    rdfs:range fibo-be-fct-pub:Publication ;
    rdfs:subPropertyOf cmns-rlcmp:isManifestedIn ;
    skos:definition "prepares and issues material for public consumption" .

fibo-be-ge-casj: a owl:Ontology ;
    rdfs:label "Central Asia Government Entities and Jurisdictions Ontology" ;
    dcterms:abstract "This ontology provides government entities and jurisdictions for countries that are defined as being part of Central Asia in the U.N. M49 codes, primarily those that are considered independent countries in ISO 3166, or are important from a banking perspective." ;
    dcterms:license """Copyright (c) 2020-2025 EDM Council, Inc.
Copyright (c) 2020-2025 Object Management Group, Inc.

