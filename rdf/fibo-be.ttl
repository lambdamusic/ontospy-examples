fibo-be-all: a owl:Ontology ;
    rdfs:label "All Business Entities (BE) Domain" ;
    dcterms:abstract """This ontology provides metadata about the FIBO Business Entities (BE) Domain, which covers defines business concepts that are used for data governance, interoperability, and in regulatory reporting about business entities.

The business scope of the BE ontologies covers a range of business and legal entities that are considered by financial industry firms, regulators and other industry participants to be of relevance in the financial services domain, including:
 - Legal entities generally
 - Corporate structure, ownership and control, including primary executive roles for businesses,
 - Functional entities such as governments and government entities, non-governmental organizations, international organizations, not-for-profit organization, etc.
 - Concepts specific to corporations, partnerships, private limited companies, sole proprietorships, and trusts.""" ;
    dcterms:contributor "Adaptive Analytics, Inc.",
        "Bloomberg LP",
        "Citigroup",
        "Credit Suisse",
        "Deutsche Bank",
        "Exprentis",
        "Federated Knowledge, LLC",
        "Hypercube Ltd.",
        "John F. Gemski",
        "Nordea Bank AB",
        "Office of Financial Research (US Dept of the Treasury)",
        "Pinnacle Bank (Morgan Hill, California)",
        "State Street Bank and Trust",
        "Statistics Canada",
        "Tahoe Blue Ltd",
        "Thematix Partners LLC",
        "Wells Fargo",
        "Working Ontologist",
        "agnos.ai UK Ltd." ;
    dcterms:creator "https://wiki.edmcouncil.org/display/BE/FIBO+-+FCT+-+Business+Entities+Home"^^xsd:anyURI ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license """Copyright (c) 2013-2025 EDM Council, Inc.
Copyright (c) 2013-2025 Object Management Group, Inc.

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the 'Software'), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED 'AS IS', WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
		
		See https://opensource.org/licenses/MIT.""" ;
    dcterms:modified "2025-10-15T18:00:00"^^xsd:dateTime ;
    dcterms:title "EDMC Financial Industry Business Ontology (FIBO) Business Entities (BE) Domain" ;
    rdfs:seeAlso "https://spec.edmcouncil.org/fibo/"^^xsd:anyURI ;
    owl:imports fibo-be-fct-fct:,
        fibo-be-fct-pub:,
        fibo-be-ge-ge:,
        fibo-be-le-cb:,
        fibo-be-le-fbo:,
        fibo-be-le-lei:,
        fibo-be-le-lp:,
        fibo-be-oac-cpty:,
        fibo-be-oac-cctl:,
        fibo-be-oac-cown:,
        fibo-be-oac-exec:,
        fibo-be-oac-opty:,
        fibo-be-ptr-ptr:,
        fibo-be-plc-plc:,
        fibo-be-sps-sps:,
        fibo-be-tr-tr:,
        <https://spec.edmcouncil.org/fibo/ontology/FND/AllFND/> ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20251001/AllBE/> ;
    cmns-av:copyright "Copyright (c) 2015-2025 EDM Council, Inc.",
        "Copyright (c) 2015-2025 Object Management Group, Inc." ;
    cmns-av:explanatoryNote "The 'all' ontology for BE is provided for convenience for FIBO users. This ontology does not add new assertions, but imports most of the Production (Released) ontologies that comprise the FIBO Business Entities (BE) domain, including all of FND but excluding individuals for governments and jurisdictions, and the related LCC region-specific ontologies." .

fibo-be-corp-corp:BoardAgreement a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass fibo-be-le-cb:BoardAgreement .

fibo-be-corp-corp:JointStockCompany a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass fibo-be-le-cb:JointStockCompany .

fibo-be-corp-corp:PrivatelyHeldCompany a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass fibo-be-le-cb:PrivatelyHeldCompany .

fibo-be-corp-corp:PubliclyHeldCompany a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass fibo-be-le-cb:PubliclyHeldCompany .

fibo-be-corp-corp:RegistrationIdentifier a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass fibo-be-le-cb:RegistrationIdentifier .

fibo-be-corp-corp:RegistrationIdentifierScheme a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass fibo-be-le-cb:RegistrationIdentifierScheme .

fibo-be-corp-corp:ReligiousCorporation a owl:Class ;
    owl:deprecated true ;
    owl:equivalentClass fibo-be-le-cb:ReligiousCorporation .

fibo-be-corp-corp:hasDateOfIncorporation a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty fibo-be-le-cb:hasDateOfIncorporation .

fibo-be-corp-corp:hasDateOfRegistration a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty fibo-be-le-cb:hasDateOfRegistration .

fibo-be-corp-corp:hasIssuedCapital a owl:ObjectProperty ;
    owl:deprecated true ;
    owl:equivalentProperty fibo-be-le-cb:hasIssuedCapital .

fibo-be-corp-corp:hasSharesAuthorized a owl:DatatypeProperty ;
    owl:deprecated true ;
    owl:equivalentProperty fibo-be-le-cb:hasSharesAuthorized .

fibo-be-corp-mod: a owl:Ontology ;
    rdfs:label "Metadata about the EDMC-FIBO Business Entities (BE) Corporations Module" ;
    dcterms:abstract "The corporations module includes ontologies describing the essential features of companies incorporated through the issuance of shares." ;
    dcterms:issued "2018-08-27T18:00:00"^^xsd:dateTime ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:modified "2023-01-24T18:00:00"^^xsd:dateTime ;
    owl:imports fibo-fnd-utl-av:,
        cmns-av: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20230101/Corporations/MetadataBECorporations/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-corp-mod:CorporationsModule a owl:NamedIndividual,
        fibo-fnd-utl-av:Module ;
    rdfs:label "corporations module" ;
    dcterms:abstract "The corporations module includes ontologies describing the essential features of companies incorporated through the issuance of shares." ;
    dcterms:hasPart fibo-be-corp-corp: ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    dcterms:title "FIBO BE Corporations Module",
        "Financial Industry Business Ontology (FIBO) Business Entities (BE) Corporations Module" ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/> ;
    cmns-av:copyright "Copyright (c) 2015-2023 EDM Council, Inc.",
        "Copyright (c) 2015-2023 Object Management Group, Inc." .

fibo-be-fct-fct:Association a owl:Class ;
    rdfs:label "association" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass fibo-be-fct-fct:CooperativeSociety ;
            owl:onProperty cmns-rlcmp:playsRole ],
        fibo-be-le-fbo:NotForProfitOrganization ;
    skos:definition "not-for-profit organization that is owned by and acts on behalf of its members" ;
    cmns-av:explanatoryNote "Associations include trade or business associations, industry sector-specific groups, and professional associations, among others. They also commonly include cooperative farms and markets." .

fibo-be-fct-fct:FamilyOffice a owl:Class ;
    rdfs:label "family office" ;
    rdfs:subClassOf fibo-be-fct-fct:FunctionalBusinessEntity ;
    skos:definition "organization that assumes the day-to-day administration and management of a family's affairs" ;
    cmns-av:explanatoryNote "Family offices are often privately held companies set up to handle investment and wealth management for wealthy families." .

fibo-be-fct-fct:SyndicateMember a owl:Class ;
    rdfs:label "syndicate member"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cmns-rlcmp:isPlayedBy ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom fibo-be-fct-fct:Syndicate ;
                    owl:onProperty cmns-col:isMemberOf ] ],
        cmns-org:OrganizationMember ;
    skos:definition "role of an individual or organization that is a member of an alliance set up to pool resources and share risk with respect to a large transaction"@en ;
    cmns-av:synonym "participating member"@en,
        "syndicate participant"@en .

fibo-be-fct-pub:APIFirstMarketDataProvider a owl:Class ;
    rdfs:label "API-first market data provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that delivers financial information primarily through programmatic interfaces, offering real-time or historical data via APIs for automated consumption" .

fibo-be-fct-pub:AlternativeDataProvider a owl:Class ;
    rdfs:label "alternative data provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that supplies non-traditional datasets derived from sources such as web activity, sentiment analysis, geospatial signals, or other alternative information channels" .

fibo-be-fct-pub:CryptoDigitalAssetDataProvider a owl:Class ;
    rdfs:label "crypto and digital-asset data provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that supplies pricing, reference data, and analytics for digital tokens and crypto-assets" .

fibo-be-fct-pub:DerivativesVolatilityDataProvider a owl:Class ;
    rdfs:label "derivatives and volatility data provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that supplies pricing, implied-volatility surfaces, and analytics for derivatives, including options, futures, and structured products" .

fibo-be-fct-pub:ExchangeSourcedDataProvider a owl:Class ;
    rdfs:label "exchange-sourced data provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that distributes financial information originating directly from trading venues, including order-book data, trades, quotes, and venue-specific reference data" .

fibo-be-fct-pub:FixedIncomeSpecialistProvider a owl:Class ;
    rdfs:label "fixed income specialist provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that focuses on pricing, reference data, and analytics for fixed-income instruments such as bonds, credit products, and money-market securities" .

fibo-be-fct-pub:InstitutionalMarketDataProvider a owl:Class ;
    rdfs:label "institutional market data provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that supplies multi-asset financial information, analytics, and reference data to financial institutions such as banks, asset managers, and trading firms" ;
    cmns-av:explanatoryNote "Institutional market data providers Offer real-time and historical market data for various asset classes. They ensure data accuracy and compliance with regulatory standards. They typically provide tools for data visualization and analysis to aid decision-making. They may also facilitate access to proprietary research and market insights. Many such firms provide APIs and other options for ease of integration with trading platforms and risk management systems" .

fibo-be-fct-pub:ReferenceDataSpecialistProvider a owl:Class ;
    rdfs:label "reference data specialist provider" ;
    rdfs:subClassOf fibo-be-fct-pub:MarketDataProvider ;
    skos:definition "market data provider that focuses on authoritative reference data, including corporate actions, instrument identifiers, classifications, and entity information aligned with ISO standards" .

fibo-be-fct-pub:hasPublisher a owl:ObjectProperty ;
    rdfs:label "has publisher" ;
    rdfs:domain fibo-be-fct-pub:Publication ;
    rdfs:range fibo-be-fct-pub:Publisher ;
    rdfs:subPropertyOf cmns-pts:hasPartyRole,
        cmns-rlcmp:manifests ;
    owl:inverseOf fibo-be-fct-pub:publishes ;
    skos:definition "indicates the party in the role of issuing the information" .

fibo-be-fct-pub:isPublishedBy a owl:ObjectProperty ;
    rdfs:label "is published by" ;
    rdfs:domain fibo-be-fct-pub:Publication ;
    rdfs:range cmns-pts:Party ;
    rdfs:subPropertyOf cmns-pts:hasParty ;
    skos:definition "identifies the independent party (i.e., the individual or organization) that disseminates the material" .

fibo-be-ge-casj:StateOfKazakhstan a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "state of Kazakhstan" ;
    skos:definition "sovereign state and polity that is Kazakhstan" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Kazakhstan ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-casj:GovernmentOfTheRepublicOfKazakhstan .

fibo-be-ge-casj:StateOfKyrgyzstan a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "state of Kyrgyzstan" ;
    skos:definition "sovereign state and polity that is Kyrgyzstan" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Kyrgyzstan ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-casj:GovernmentOfTheKyrgyzRepublic .

fibo-be-ge-casj:StateOfTajikistan a owl:NamedIndividual,
