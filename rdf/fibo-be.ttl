fibo-be-ge-ukj:EnglandAndWalesJurisdiction a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "England and Wales jurisdiction" ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Courts_of_England_and_Wales>,
        <https://law.gov.wales/> ;
    skos:definition "jurisdiction of the Courts of England and Wales" ;
