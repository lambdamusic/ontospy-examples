    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Nicaragua ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-ctlaj:GovernmentOfTheRepublicOfNicaragua .

fibo-be-ge-ctlaj:PanamanianEntity a owl:NamedIndividual,
