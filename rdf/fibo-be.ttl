        fibo-be-ge-neuj:,
        fibo-be-ge-seuj:,
        fibo-be-ge-ukj:,
        fibo-be-ge-weuj:,
        fibo-be-ge-ge:,
        fibo-fnd-utl-av:,
        cmns-av:,
        cmns-col:,
        cmns-rga:,
        cmns-rlcmp:,
        lcc-3166-1: ;
    owl:versionIRI <https://spec.edmcouncil.org/fibo/ontology/BE/20251101/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions/> ;
    skos:changeNote "The https://spec.edmcouncil.org/fibo/ontology/BE/20180801/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to remove the UK from coverage by the EU jurisdiction and replace references to the Czech Republic with Czechia.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20190101/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to remove the unnecessary imports.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20220201/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to address text formatting hygiene issues.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20220801/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions.rdf version of the ontology was modified to use the Commons Ontology Library (Commons) Annotation Vocabulary rather than the OMG's Specification Metadata vocabulary.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230101/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions.rdf version of the ontology was modified to replace additional content that is now available in the OMG Commons Ontology Library (Commons) v1.2 (FND-389).",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20230101/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to use the Commons Ontology Library (Commons) rather than the OMG's Languages, Countries and Codes (LCC) and to eliminate redundancies in FIBO as appropriate.",
        "The https://spec.edmcouncil.org/fibo/ontology/BE/20250301/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions.rdf version of this ontology was modified to add EU entities and jurisdictions needed for various initiatives (BE-262)." ;
    fibo-fnd-utl-av:hasMaturityLevel fibo-fnd-utl-av:Release ;
    cmns-av:copyright "Copyright (c) 2020-2025 EDM Council, Inc.",
        "Copyright (c) 2020-2025 Object Management Group, Inc." .

fibo-be-ge-euj:EuropeanCommission a owl:NamedIndividual,
        fibo-be-ge-ge:SupranationalEntity ;
    rdfs:label "European Commission" ;
    skos:definition "supranational entity that helps to shape the EU's overall strategy, proposes new EU laws and policies, monitors their implementation and manages the EU budget" ;
    skos:note "The European Commission also plays a significant role in supporting international development and delivering aid." ;
    cmns-av:abbreviation "EC" ;
    cmns-av:directSource <https://ec.europa.eu/info/about-european-commission> .

fibo-be-ge-eeuj:BulgarianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Българско образувание"@bg,
        "Bulgarian entity"@en ;
    skos:definition "sovereign state and polity that is Bulgaria" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Bulgaria ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfTheRepublicOfBulgaria .

fibo-be-ge-eeuj:CzechEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Český subjekt"@cs,
        "Czech entity"@en ;
    skos:definition "sovereign state and polity that is Czechia" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Czechia ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfTheCzechRepublic .

fibo-be-ge-eeuj:HungarianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Hungarian entity"@en,
        "Magyar entitás"@hu ;
    skos:definition "sovereign state and polity that is Hungary" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Hungary ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfHungary .

fibo-be-ge-eeuj:JurisdictionOfBelarus a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "юрысдыкцыя Беларусі"@be,
        "jurisdiction of Belarus"@en,
        "юрисдикция Беларуси"@ru ;
    skos:definition "jurisdiction of the judiciary of Belarus, consisting of the Supreme Court and specialized courts such as the Constitutional Court, which deals with specific issues related to constitutional and business law" ;
    cmns-rga:hasReach lcc-3166-1:Belarus ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfTheRepublicOfBelarus .

fibo-be-ge-eeuj:JurisdictionOfBulgaria a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "юрисдикция на България"@bg,
        "jurisdiction of Bulgaria"@en ;
    skos:definition "jurisdiction of the judiciary of Bulgaria, a civil law legal system under the Ministry of Justice, including the Supreme Administrative Court and the Supreme Court of Cassation, which are the highest courts of appeal and oversee the application of laws in subordinate courts" ;
    cmns-rga:hasReach lcc-3166-1:Bulgaria ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfTheRepublicOfBulgaria .

fibo-be-ge-eeuj:JurisdictionOfCzechia a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdikce česka"@cs,
        "jurisdiction of Czechia"@en ;
    skos:definition "jurisdiction of the judiciary of the Czech Republic, a civil law system grounded in the Constitution of the Czech Republic, including the Constitutional Court, Supreme Court, and Supreme Administrative Court, as well as district and county courts that are divided into civil, criminal, and administrative branches" ;
    cmns-rga:hasReach lcc-3166-1:Czechia ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfTheCzechRepublic .

fibo-be-ge-eeuj:JurisdictionOfHungary a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Hungary"@en,
        "Magyarország joghatósága"@hu ;
    skos:definition "jurisdiction of the judiciary of Hungary, a civil law system based primarily on German that is divided between courts with regular civil and criminal jurisdiction and administrative courts, including local courts, regional appellate courts, and the supreme court" ;
    cmns-rga:hasReach lcc-3166-1:Hungary ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfHungary .

fibo-be-ge-eeuj:JurisdictionOfMoldova a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Moldova"@en,
        "jurisdicția Moldovei"@ro ;
    skos:definition "jurisdiction of the judiciary of Moldova, which is the system of courts that interprets and applies the law in Moldova, including an independent Constitutional Court" ;
    cmns-rga:hasReach lcc-3166-1:Moldova ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfTheRepublicOfMoldova .

fibo-be-ge-eeuj:JurisdictionOfPoland a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Poland"@en,
        "jurysdykcja Polski"@pl ;
    skos:definition "jurisdiction of the judiciary of Poland, a four-tier court system composed of the Supreme Court, the Supreme Administrative Court, Common Courts (District, Regional, Appellate) and the Military Court" ;
    cmns-rga:hasReach lcc-3166-1:Poland ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfTheRepublicOfPoland .

fibo-be-ge-eeuj:JurisdictionOfRomania a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Romania"@en,
        "jurisdicția României"@ro ;
    skos:definition "jurisdiction of the judiciary of Romania, a civil law system influenced by the French system that is a hierarchical system of courts with the High Court of Cassation and Justice being the supreme court of Romania, and includes courts of appeal, county courts and local courts" ;
    cmns-rga:hasReach lcc-3166-1:Romania ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfRomania .

fibo-be-ge-eeuj:JurisdictionOfRussianFederation a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Russian Federation"@en,
        "юрисдикция Российской Федерации"@ru ;
    skos:definition "jurisdiction of the judiciary of Russian Federation, which is the system of courts that interprets and applies the law in the Russian Federation, including Constitutional Court, Supreme Court and lower federal courts, whose judges are appointed by the Federation Council on the recommendation of the President" ;
    cmns-rga:hasReach lcc-3166-1:RussianFederation ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfTheRussianFederation .

fibo-be-ge-eeuj:JurisdictionOfSlovakia a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Slovakia"@en,
        "jurisdikcia Slovenska"@sk ;
    skos:definition "jurisdiction of the judiciary of the Slovak Republic, which is the system of courts that interprets and applies the law in Slovakia, whose highest judicial body is the Constitutional Court of Slovakia, which rules on constitutional issues" ;
    cmns-rga:hasReach lcc-3166-1:Slovakia ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfTheSlovakRepublic .

fibo-be-ge-eeuj:JurisdictionOfUkraine a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Ukraine"@en,
        "юрисдикція України"@uk ;
    skos:definition "jurisdiction of the judiciary of Ukraine, which is the system of courts that interprets and applies the law in Ukraine, including the Supreme Court of Ukraine, which is the highest judicial body in the system of courts of general jurisdiction in Ukraine" ;
    cmns-rga:hasReach lcc-3166-1:Ukraine ;
    cmns-rga:isJurisdictionOf fibo-be-ge-eeuj:GovernmentOfUkraine .

fibo-be-ge-eeuj:MoldovanEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Moldovan entity"@en,
        "Entitate moldovenească"@ro ;
    skos:definition "sovereign state and polity that is Moldova" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Moldova ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfTheRepublicOfMoldova .

fibo-be-ge-eeuj:PolishEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Polish entity"@en,
        "Podmiot polski"@pl ;
    skos:definition "sovereign state and polity that is Poland" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Poland ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfTheRepublicOfPoland .

fibo-be-ge-eeuj:RomanianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Romanian entity"@en,
        "Entitate românească"@ro ;
    skos:definition "sovereign state and polity that is Romania" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Romania ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfRomania .

fibo-be-ge-eeuj:SlovakEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Slovak entity"@en,
        "Slovenský subjekt"@sk ;
    skos:definition "sovereign state and polity that is Slovakia" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Slovakia ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfTheSlovakRepublic .

fibo-be-ge-eeuj:UkranianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Ukrainian entity"@en,
        "Українське утворення"@uk ;
    skos:definition "sovereign state and polity that is Ukraine" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Ukraine ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-eeuj:GovernmentOfUkraine .

fibo-be-ge-neuj:AlandIslandsJurisdiction a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "Aland Islands jurisdiction"@en,
        "Ahvenanmaan lainkäyttöalue"@fi,
        "Ålandöarnas jurisdiktion"@sv ;
    rdfs:seeAlso <https://www.lexadin.nl/wlg/courts/nofr/eur/lxctfin.htm/> ;
    skos:definition "jurisdiction of the Aland District Court, which deals with criminal cases, civil cases and petitionary matters in first instance, with escalation to the appellate level in Finland as needed" ;
    cmns-av:synonym "Ålands tingsrätt"@fi ;
    cmns-rga:hasReach lcc-3166-1:AlandIslands ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfAland .

fibo-be-ge-neuj:DanishEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Dansk enhed"@da,
        "Danish entity"@en ;
    skos:definition "sovereign state and polity that is Denmark" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Denmark ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:FaroeIslands,
        lcc-3166-1:Greenland ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-neuj:GovernmentOfTheKingdomOfDenmark .

fibo-be-ge-neuj:EstonianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Estonian entity"@en,
        "Eesti üksus"@et ;
    skos:definition "sovereign state and polity that is Estonia" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Estonia ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-neuj:GovernmentOfTheRepublicOfEstonia .

fibo-be-ge-neuj:FinnishEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Finnish entity"@en,
        "Suomen entiteetti"@fi ;
    skos:definition "sovereign state and polity that is Finland" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Finland ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-1:AlandIslands ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-neuj:GovernmentOfTheRepublicOfFinland .

fibo-be-ge-neuj:IrishEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Irish entity"@en,
        "Aonán Éireannach"@ga ;
    skos:definition "sovereign state and polity that is Ireland" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Ireland ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-neuj:GovernmentOfTheRepublicOfIreland .

fibo-be-ge-neuj:JurisdictionOfDenmark a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "Danmarks jurisdiktion"@da,
        "jurisdiction of Denmark"@en ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Courts_of_Denmark/> ;
    skos:definition "jurisdiction of the judiciary of Denmark, a civil law system with some references to Germanic law that was substantially reformed in 2007" ;
    cmns-rga:hasReach lcc-3166-1:Denmark ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheKingdomOfDenmark .

fibo-be-ge-neuj:JurisdictionOfEstonia a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Estonia"@en,
        "Eesti jurisdiktsioon"@et ;
    rdfs:seeAlso <https://www.kohus.ee/en/estonian-courts/estonian-court-system> ;
    skos:definition "jurisdiction of the judiciary of Estonia, a civil law legal system based on the Germanic legal model, whose Supreme Court is the court of cassation, which also conducts constitutional review" ;
    cmns-rga:hasReach lcc-3166-1:Estonia ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheRepublicOfEstonia .

fibo-be-ge-neuj:JurisdictionOfFinland a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Finland"@en,
        "Suomen lainkäyttövaltaan"@fi ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Judicial_system_of_Finland> ;
    skos:definition "jurisdiction of the judiciary of Finland, a civil law system divided between courts with regular civil and criminal jurisdiction and administrative courts with jurisdiction over litigation between individuals and the public administration" ;
    cmns-rga:hasReach lcc-3166-1:Finland ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheRepublicOfFinland .

fibo-be-ge-neuj:JurisdictionOfIceland a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Iceland"@en,
        "lögsögu Íslands"@is ;
    rdfs:seeAlso <https://www.government.is/topics/law-and-order/the-judicial-system-in-iceland/> ;
    skos:definition "jurisdiction of the judiciary of Finland, a three-tier civil law system whose highest court is the Supreme Court of Iceland" ;
    cmns-rga:hasReach lcc-3166-1:Iceland ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfIceland .

fibo-be-ge-neuj:JurisdictionOfIreland a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Ireland"@en,
        "dlínse na hÉireann"@ga ;
    rdfs:seeAlso <https://www.citizensinformation.ie/en/justice/courts_system/> ;
    skos:definition "jurisdiction of the judiciary of Ireland, which is the system of courts that interprets and applies the law in Ireland" ;
    cmns-rga:hasReach lcc-3166-1:Ireland ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheRepublicOfIreland .

fibo-be-ge-neuj:JurisdictionOfLatvia a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Latvia"@en,
        "Latvijas jurisdikcija"@lv ;
    rdfs:seeAlso <http://www.satv.tiesa.gov.lv/> ;
    skos:definition "jurisdiction of the judiciary of Latvia, which is the system of courts that interprets and applies the law in Latvia" ;
    cmns-rga:hasReach lcc-3166-1:Latvia ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheRepublicOfLatvia .

fibo-be-ge-neuj:JurisdictionOfLithuania a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Lithuania"@en,
        "Lietuvos jurisdikcija"@lt ;
    rdfs:seeAlso <https://www.teismai.lt/en/courts/judicial-system/650> ;
    skos:definition "jurisdiction of the judiciary of Lithuania, whose highest court is the Constitutional Court (Konstitucinis Teismas), but the general jurisdiction dealing with civil and criminal cases includes the Supreme Court of Lithuania, the Court of Appeal of Lithuania, regional courts, and district courts" ;
    cmns-rga:hasReach lcc-3166-1:Lithuania ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheRepublicOfLithuania .

fibo-be-ge-neuj:JurisdictionOfNorway a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Norway"@en,
        "jurisdiksjon av Norge"@no ;
    rdfs:seeAlso <https://www.domstol.no/en/> ;
    skos:definition "jurisdiction of the judiciary system in Norway, a civil law system where laws are created and amended in parliament and the system regulated through the Courts of Justice of Norway" ;
    cmns-rga:hasReach lcc-3166-1:Norway ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheKingdomOfNorway .

fibo-be-ge-neuj:JurisdictionOfSweden a owl:NamedIndividual,
        cmns-rga:Jurisdiction ;
    rdfs:label "jurisdiction of Sweden"@en,
        "Sveriges jurisdiktion"@sv ;
    rdfs:seeAlso <https://www.government.se/information-material/2019/03/organisation-and-responsibilities-of-the-ministry-of-justice/> ;
    skos:definition "jurisdiction of the judiciary system in Sweden, which is part of the Ministry of Justice, whose courts are divided into two parallel and separate systems - general courts (allmänna domstolar) for criminal and civil cases, and general administrative courts (allmänna förvaltningsdomstolar) for cases relating to disputes between private persons and the authorities" ;
    cmns-rga:hasReach lcc-3166-1:Sweden ;
    cmns-rga:isJurisdictionOf fibo-be-ge-neuj:GovernmentOfTheKingdomOfSweden .

fibo-be-ge-neuj:LatvianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Latvian entity"@en,
        "Latvijas vienība"@lv ;
    skos:definition "sovereign state and polity that is Latvia" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Latvia ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-neuj:GovernmentOfTheRepublicOfLatvia .

fibo-be-ge-neuj:LithuanianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Lithuanian entity"@en,
        "Lietuvos subjektas"@lt ;
    skos:definition "sovereign state and polity that is Lithuania" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Lithuania ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-neuj:GovernmentOfTheRepublicOfLithuania .

fibo-be-ge-neuj:SwedishEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Swedish entity"@en,
        "Svensk enhet"@sv ;
    skos:definition "sovereign state and polity that is Sweden" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Sweden ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-neuj:GovernmentOfTheKingdomOfSweden .

fibo-be-ge-seuj:AlbanianEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Albanian entity"@en,
        "Entiteti shqiptar"@sq ;
    skos:definition "sovereign state and polity that is Albania" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Albania ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-seuj:GovernmentOfTheRepublicOfAlbania .

fibo-be-ge-seuj:AndorranEntity a owl:NamedIndividual,
        fibo-be-ge-ge:SovereignState ;
    rdfs:label "Entitat andorrana"@ca,
        "Andorran entity"@en ;
    skos:definition "sovereign state and polity that is Andorra" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:Andorra ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-seuj:GovernmentOfThePrincipalityOfAndorra .

fibo-be-ge-seuj:BosnianAndHerzegovinianEntity a owl:NamedIndividual,
