        fibo-be-ge-ge:SupranationalEntity ;
    rdfs:label "European Free Trade Association" ;
    skos:definition "intergovernmental organization of Iceland, Liechtenstein, Norway and Switzerland set up for the promotion of free trade and economic cooperation between its members, within Europe, and globally" ;
    skos:note "EFTA was established in 1960 by its then seven Member States for the promotion of free trade and economic integration between its members. The four EFTA States are competitive in several sectors vital to the global economy and score among the highest in the world in competitiveness, wealth creation per inhabitant, life expectancy and quality of life." ;
    cmns-av:abbreviation "EFTA" ;
    cmns-av:adaptedFrom "https://www.efta.int/about-efta"^^xsd:anyURI ;
    cmns-col:hasMember fibo-be-ge-neuj:IcelandicEntity,
        fibo-be-ge-neuj:NorwegianEntity,
        fibo-be-ge-weuj:LiechtensteinerEntity,
        fibo-be-ge-weuj:SwissEntity .

